// ==================== الإنتاجية ====================

model Task {
  id             Int       @id @default(autoincrement())
  title          String
  details        String    @default("")
  dueAt          String    @map("due_at") // YYYY-MM-DD HH:mm
  remindMinutes  Int       @default(30) @map("remind_minutes")
  source         String    @default("يدوية")
  taskType       String    @default("تذكير") @map("task_type") // تذكير|موعد
  status         String    @default("مفتوحة") // مفتوحة|منجزة
  notifiedBefore Boolean   @default(false) @map("notified_before")
  notifiedAfter  Boolean   @default(false) @map("notified_after")
  doneAt         String    @default("") @map("done_at")
  customerId     Int?      @map("customer_id")
  customer       Customer? @relation(fields: [customerId], references: [id])
  contractId     Int?      @map("contract_id")
  contract       Contract? @relation(fields: [contractId], references: [id])
  visits         Visit[]
  createdAt      DateTime  @default(now())

  @@index([status, dueAt])
  @@map("tasks")
}

model VisitStaff {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String  @default("")
  active Boolean @default(true)
  sort   Int     @default(0)
  visits Visit[]

  @@map("visit_staff")
}

model Visit {
  id         Int        @id @default(autoincrement())
  visitDate  String     @map("visit_date") // YYYY-MM-DD
  hourSlot   String     @map("hour_slot") // "08:00"
  staffId    Int        @map("staff_id")
  staff      VisitStaff @relation(fields: [staffId], references: [id])
  customerId Int?       @map("customer_id")
  customer   Customer?  @relation(fields: [customerId], references: [id])
  note       String     @default("")
  taskId     Int?       @map("task_id")
  task       Task?      @relation(fields: [taskId], references: [id])
  createdBy  String     @default("") @map("created_by")
  createdAt  DateTime   @default(now())

  @@unique([visitDate, hourSlot, staffId])
  @@map("visits")
}

model Comment {
  id           Int       @id @default(autoincrement())
  customerId   Int       @map("customer_id")
  customer     Customer  @relation(fields: [customerId], references: [id])
  contractId   Int?      @map("contract_id")
  contract     Contract? @relation(fields: [contractId], references: [id])
  body         String
  createdBy    String    @default("") @map("created_by")
  author       String    @default("")
  pinned       Boolean   @default(false)
  editedAt     String    @default("") @map("edited_at")
  editor       String    @default("")
  kind         String    @default("عام") // عام|مالية|بلدية|قانونية|تنفيذ|مستندات|اتصال
  priority     String    @default("عادي") // عادي|مهم|عاجل
  status       String    @default("مفتوح") // مفتوح|تم|مؤجل|ملغى
  tags         String    @default("")
  followupDate String    @default("") @map("followup_date")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    String    @default("") @map("deleted_at")
  deleteReason String    @default("") @map("delete_reason")
  source       String    @default("")
  createdAt    DateTime  @default(now())

  @@index([customerId, isDeleted, pinned])
  @@map("customer_comments")
}

model ContractAttachment {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name")
  storedPath String   @map("stored_path")
  addedAt    String   @default("") @map("added_at")

  @@map("contract_attachments")
}

// ==================== البوابة المالية ====================

model GatewayProfile {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  bankAccount String  @default("") @map("bank_account")
  methods     String  @default("KNET")
  lagDays     Int     @default(1) @map("lag_days")
  feeFixed    Decimal @default(0) @map("fee_fixed")
  tolerance   Decimal @default(0.005)
  lateDays    Int     @default(3) @map("late_days")
  isActive    Boolean @default(true) @map("is_active")

  @@map("gateway_profiles")
}

model GatewayOp {
  id               Int                   @id @default(autoincrement())
  gateway          String                @default("")
  opDate           String                @default("") @map("op_date")
  phone            String                @default("")
  amount           Decimal               @default(0)
  ref              String                @default("")
  status           String                @default("") // mine|other|unmarked
  receiptNo        String                @default("") @map("receipt_no")
  customer         String                @default("")
  batch            String                @default("")
  paidTransferId   Int?                  @map("paid_transfer_id")
  paidTransfer     OtherCompanyTransfer? @relation(fields: [paidTransferId], references: [id], onDelete: SetNull)
  classifiedManual Boolean               @default(false) @map("classified_manual")
  distributed      Boolean               @default(false)
  distributedAt    String                @default("") @map("distributed_at")
  gwPaid           Int?                  @map("gw_paid") // 1 محوّلة 0 معلقة 2 ملغاة -1 فاشلة
  gwPaidDate       String                @default("") @map("gw_paid_date")
  gwToken          String                @default("") @map("gw_token")
  effectiveDate    String                @default("") @map("effective_date")
  allocs           TransferOpAlloc[]
  feeLinks         GatewayFeeVoucher[]
  createdAt        DateTime              @default(now())

  @@unique([gateway, opDate, phone, amount, ref])
  @@index([gateway, distributed, status])
  @@map("gateway_ops")
}

model BankLine {
  id          Int      @id @default(autoincrement())
  bankAccount String   @default("") @map("bank_account")
  cdate       String
  amount      Decimal  @default(0)
  descr       String   @default("")
  batch       String   @default("")
  createdAt   DateTime @default(now())

  @@unique([bankAccount, cdate, amount, descr])
  @@map("bank_lines")
}

model OtherCompanyTransfer {
  id            Int               @id @default(autoincrement())
  tdate         String
  amount        Decimal           @default(0)
  ref           String            @default("")
  notes         String            @default("")
  method        String            @default("")
  voucherId     Int               @default(0) @map("voucher_id") // legacy — لا يُنشأ سند
  voucherNumber String            @default("") @map("voucher_number")
  allocs        TransferOpAlloc[]
  paidOps       GatewayOp[]
  createdAt     DateTime          @default(now())

  @@map("other_company_transfers")
}

model TransferOpAlloc {
  id         Int                   @id @default(autoincrement())
  transferId Int                   @default(0) @map("transfer_id")
  transfer   OtherCompanyTransfer? @relation(fields: [transferId], references: [id])
  opId       Int                   @default(0) @map("op_id")
  op         GatewayOp?            @relation(fields: [opId], references: [id])
  amount     Decimal               @default(0)

  @@index([opId])
  @@index([transferId])
  @@map("transfer_op_allocs")
}

model OtherCompanyOpening {
  id        Int      @id @default(1)
  amount    Decimal  @default(0)
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("other_company_opening")
}

model GatewayFeeVoucher {
  opId       Int       @id @map("op_id")
  op         GatewayOp @relation(fields: [opId], references: [id])
  voucherId  Int       @map("voucher_id")
  voucher    Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  transferId Int       @default(0) @map("transfer_id")
  fee        Decimal

  @@map("gateway_fee_vouchers")
}

model MatchAlias {
  id         Int      @id @default(autoincrement())
  filePhone  String   @default("") @map("file_phone")
  fileName   String   @default("") @map("file_name")
  customerId Int      @default(0) @map("customer_id")
  createdAt  DateTime @default(now())

  @@unique([filePhone, fileName])
  @@map("match_aliases")
}

// ==================== القيود والأحداث والقوالب ====================

model JournalEntry {
  id            Int      @id @default(autoincrement())
  entryDate     String   @map("entry_date")
  description   String   @default("")
  debitAccount  String   @default("") @map("debit_account")
  creditAccount String   @default("") @map("credit_account")
  amount        Decimal
  projectId     Int?     @map("project_id")
  contractId    Int?     @map("contract_id")
  boqItemId     Int?     @map("boq_item_id")
  subContractId Int?     @map("sub_contract_id")
  costCenter    String   @default("") @map("cost_center")
  sourceType    String   @default("") @map("source_type")
  sourceId      Int?     @map("source_id")
  createdAt     DateTime @default(now())

  @@index([entryDate])
  @@map("journal_entries")
}

model ContractEvent {
  id          Int      @id @default(autoincrement())
  contractId  Int      @map("contract_id")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  eventTime   DateTime @default(now()) @map("event_time")
  eventType   String   @map("event_type")
  description String   @default("")
  username    String   @default("")

  @@index([contractId])
  @@map("contract_events")
}

model FormCategory {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  sort      Int            @default(0)
  templates FormTemplate[]

  @@map("form_categories")
}

model FormTemplate {
  id            Int            @id @default(autoincrement())
  baseName      String         @map("base_name")
  version       Int            @default(1)
  description   String         @default("")
  categoryId    Int?           @map("category_id")
  category      FormCategory?  @relation(fields: [categoryId], references: [id])
  status        String         @default("مسودة") // مسودة|معتمد|معطل|مؤرشف
  pdfPath       String         @default("") @map("pdf_path")
  pagesCount    Int            @default(1) @map("pages_count")
  printIdentity String         @default("none") @map("print_identity") // none|logo|full
  sourceType    String         @default("word") @map("source_type")
  wordPath      String         @default("") @map("word_path")
  createdBy     String         @default("") @map("created_by")
  updatedBy     String         @default("") @map("updated_by")
  fields        FormField[]
  documents     FormDocument[]
  createdAt     DateTime       @default(now())

  @@map("form_templates")
}

model FormField {
  id               Int          @id @default(autoincrement())
  templateId       Int          @map("template_id")
  template         FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name             String
  fieldType        String       @default("text") @map("field_type")
  page             Int          @default(1)
  x                Float        @default(0)
  y                Float        @default(0)
  w                Float        @default(120)
  h                Float        @default(18)
  sourceType       String       @default("manual") @map("source_type") // manual|system|auto|calc
  sourceEntity     String       @default("") @map("source_entity")
  sourceKey        String       @default("") @map("source_key")
  context          String       @default("")
  defaultValue     String       @default("") @map("default_value")
  options          String       @default("")
  required         Boolean      @default(false)
  align            String       @default("right")
  sort             Int          @default(0)
  continuesFieldId Int?         @map("continues_field_id")
  continuesFrom    FormField?   @relation("continuesChain", fields: [continuesFieldId], references: [id], onDelete: SetNull)
  continuesNext    FormField[]  @relation("continuesChain")
  placeholder      String       @default("")

  @@index([templateId])
  @@map("form_fields")
}

model FormDocument {
  id              Int          @id @default(autoincrement())
  templateId      Int          @map("template_id")
  template        FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion Int          @default(1) @map("template_version")
  title           String       @default("")
  valuesJson      String       @default("{}") @map("values_json")
  pdfPath         String       @default("") @map("pdf_path")
  wordPath        String       @default("") @map("word_path")
  customerId      Int?         @map("customer_id")
  contractId      Int?         @map("contract_id")
  createdBy       String       @default("") @map("created_by")
  createdAt       DateTime     @default(now())

  @@map("form_documents")
}

// ==================== المرحلة 7-ب: ملاحظات المراحل ومحادثة المعاملة ====================

/** ملاحظة على معاملة (سبب التأخير / واقفة فين) — StageNoteDialog المكتبية V5.9 */
model StageNote {
  id         Int       @id @default(autoincrement())
  txType     String    @default("contract")
  txId       Int
  contractId Int?      @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stageName  String    @default("") @map("stage_name")
  note       String
  author     String
  createdAt  DateTime  @default(now())

  @@index([txType, txId])
  @@map("stage_notes")
}

/**
 * تنبيهات نظامية مخفاة لكل مستخدم (V9.15.6 مكتبية — workflow_service._ensure_dismissed_table).
 * المفتاح = بصمة sha1 لنص التنبيه — إذا تغيّرت بياناته (مبلغ/تاريخ/حالة) يعود ظاهرًا.
 */
model DismissedAlert {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertKey  String   @map("alert_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, alertKey])
  @@map("dismissed_alerts")
}

/** رسالة محادثة المعاملة — شات FollowupPanel المكتبي */
model TxMessage {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  username   String
  body       String
  createdAt  DateTime @default(now())

  @@index([contractId])
  @@map("tx_messages")
}
