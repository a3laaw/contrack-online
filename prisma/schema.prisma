  taskId     Int?       @map("task_id")
  task       Task?      @relation(fields: [taskId], references: [id])
  createdBy  String     @default("") @map("created_by")
  createdAt  DateTime   @default(now())

  @@unique([visitDate, hourSlot, staffId])
  @@map("visits")
}

model Comment {
