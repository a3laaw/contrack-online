/** ملاحظة على معاملة (سبب التأخير / واقفة فين) — StageNoteDialog المكتبية V5.9 */
model StageNote {
  companyId Int @default(1) @map("company_id")
  id         Int       @id @default(autoincrement())
  txType     String    @default("contract")
  txId       Int
  contractId Int?      @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stageName  String    @default("") @map("stage_name")
  note       String
  author     String
  createdAt  DateTime  @default(now())

  @@index([txType, txId])
  @@map("stage_notes")
}

/**
 * تنبيهات نظامية مخفاة لكل مستخدم (V9.15.6 مكتبية — workflow_service._ensure_dismissed_table).
 * المفتاح = بصمة sha1 لنص التنبيه — إذا تغيّرت بياناته (مبلغ/تاريخ/حالة) يعود ظاهرًا.
 */
model DismissedAlert {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertKey  String   @map("alert_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, alertKey])
  @@map("dismissed_alerts")
}

/** رسالة محادثة المعاملة — شات FollowupPanel المكتبي */
model TxMessage {
  companyId Int @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  username   String
  body       String
  createdAt  DateTime @default(now())

  @@index([contractId])
  @@map("tx_messages")
}

// ==================== SaaS التجاري (Task 115) ====================
// الطبقة التجارية فوق عزل Task 85 القائم — جداول جديدة حصرًا بلا أي تعديل
// على الجداول القائمة. الخطط كتالوج عام، الاشتراك لكل شركة (واحد إلزامي-فريد)،
// وطلبات الانضمام طابور موافقة المطور (التسجيل الذاتي بلا إنشاء فوري).

/** خطة اشتراك — كتالوج عام يبذرها النظام (durationDays=0 ⇒ دائم بلا انتهاء) */
model Plan {
  id           Int            @id @default(autoincrement())
  code         String         @unique // trial | basic | pro | enterprise
  name         String
  durationDays Int            @default(365) @map("duration_days") // 0 = دائم
  maxUsers     Int            @default(3) @map("max_users")
  maxDivisions Int            @default(1) @map("max_divisions")
  priceMonthly Decimal        @default(0) @db.Decimal(10, 3) @map("price_monthly") // للعرض — التسعير يُقرر لاحقًا
  isActive     Boolean        @default(true) @map("is_active")
  sortOrder    Int            @default(0) @map("sort_order")
  subscriptions Subscription[]

  @@map("plans")
}

/** اشتراك الشركة — صف واحد لكل شركة؛ الحالة الفعلية تُحسب مع انتهاء المدة */
model Subscription {
  id        Int       @id @default(autoincrement())
  companyId Int       @unique @map("company_id")
  company   Company   @relation("SubscriptionCompany", fields: [companyId], references: [id], onDelete: Cascade)
  planId    Int       @map("plan_id")
  plan      Plan      @relation(fields: [planId], references: [id])
  status    String    @default("trial") // trial | active | frozen | cancelled
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at") // null = دائم بلا انتهاء
  notes     String    @default("")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

/**
 * طلب انضمام شركة — التسجيل الذاتي يُنشئ طلبًا معلقًا لا شركة، والمطور وحده
 * يعتمده (إنشاء شركة + بذر + مدير أول + اشتراك تجريبي) أو يرفضه بسبب موثق.
 * كلمة المرور تُخزَّن مُهشَّرة PBKDF2 منذ لحظة الطلب (لا نص صريح أبدًا).
 */
model RegistrationRequest {
  id                Int       @id @default(autoincrement())
  companyName       String    @map("company_name")
  shortName         String    @default("") @map("short_name")
  contactName       String    @map("contact_name")
  phone             String    @default("")
  email             String    @default("")
  activity          String    @default("") // النشاط المطلوب — تسمية مشتقة من اختيار الموديولات (للعرض والتوافق)
  activityType      String    @default("") @map("activity_type") // كود نوع النشاط (الكتالوج في activity-types.ts) — فارغ لطلبات ما قبل التقسيم
  requestedUsername String    @map("requested_username")
  passwordHash      String    @map("password_hash")
  salt              String
  adminFullName     String    @default("") @map("admin_full_name")
  status            String    @default("pending") // pending | approved | rejected
  rejectionReason   String    @default("") @map("rejection_reason")
  createdCompanyId  Int?      @map("created_company_id")
  processedBy       String    @default("") @map("processed_by")
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  modules           String    @default("[]") @map("modules") // الأنشطة المختارة JSON — ["contracting",…] (الكتالوج في modules-catalog.ts)
  @@index([status, createdAt])
  @@map("registration_requests")
}

/**
 * موديول (نشاط) مفعّل لشركة — المرحلة A من خطة الأنشطة:
 * الكتالوج يُعرّف في modules-catalog.ts (مصدر واحد للحقيقة)، وهنا حالة التفعيل لكل شركة.
 * الإيقاف (disabled) = تجميد: الشاشات تختفي من الشل والبيانات محفوظة كاملة — لا حذف أبدًا.
 */
model CompanyModule {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  company   Company  @relation("CompanyModules", fields: [companyId], references: [id], onDelete: Cascade)
  code      String // contracting | consulting | warehouses | sales | maintenance (الكور accounting مشمول دائمًا بلا صف)
  status    String   @default("active") // active | disabled
  enabledBy String   @default("") @map("enabled_by") // اسم الفاعل (المطور أو اعتماد طلب انضمام)
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([code])
  @@map("company_modules")
}

/** قسم (Division) — وحدة الفصل المالي داخل الشركة: قسم افتراضي يُبذر لكل موديول مفعّل (المرحلة B ستصل القيود به) */
model Division {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  company    Company  @relation("CompanyDivisions", fields: [companyId], references: [id], onDelete: Cascade)
  code       String   @default("") // فريد داخل الشركة — نمط div-<module>
  name       String
  moduleCode String   @default("") @map("module_code") // النشاط المالك للقسم
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("divisions")
}

// ==================== الاستشارات الهندسية (موديول consulting — خطة الأنشطة) ====================
// كيان «المهندس» مستقل عن Employee (موظفو السلف في العُهد) — نطاقه موديول الاستشارات حصرًا.
// إيقاف الموديول = تجميد قراءة فقط كما باقي الأنشطة — البيانات لا تُحذف أبدًا.

/** المهندس/موظف الاستشارات — التخصص والترخيص المهني (عضوية الهيئة/الترخيص) مع تنبيه قبل انتهائه */
model Engineer {
  companyId     Int      @default(1) @map("company_id")
  id            Int      @id @default(autoincrement())
  name          String
  jobTitle      String   @default("") @map("job_title") // المسمى: مدير مشروع / مهندس تصميم / مهندس إشراف…
  specialty     String   @default("") // التخصص الهندسي: عمارة / إنشائي / كهرباء / ميكانيكا…
  civilId       String   @default("") @map("civil_id") // الرقم المدني الكويتي
  nationality   String   @default("")
  phone         String   @default("")
  email         String   @default("")
  licenseNo     String   @default("") @map("license_no") // رقم العضوية/الترخيص المهني
  licenseExpiry String   @default("") @map("license_expiry") // YYYY-MM-DD — مصدر تنبيه القرب
  hireDate      String   @default("") @map("hire_date")
  baseSalary    Decimal  @default(0) @map("base_salary") // استرشادي — مسير الرواتب بمرحلة لاحقة
  status        String   @default("نشط") // نشط | في إجازة | موقوف | منتهي الخدمة
  notes         String   @default("")
  assignments   EngineerAssignment[]
  timesheets    EngineerTimesheet[]
  leaves        EngineerLeave[]
  // مراجعات المخططات — إصدارات المخطط التي أعدّها المهندس (docs/revisions-ipc-design.md §1)
  revisions     ConsultingRevision[]
  // رادار المواعيد — الخانات المحجوزة للمهندس (docs/consulting-radar-design.md)
  appointments  EngineerAppointment[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("engineers")
}

/** إسناد مهندس إلى عقد/مشروع — نقطة الربط HR↔العقود (الأهم في تصميم الاستشارات) */
model EngineerAssignment {
  companyId     Int      @default(1) @map("company_id")
  id            Int      @id @default(autoincrement())
  engineerId    Int      @map("engineer_id")
  engineer      Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  contractId    Int      @map("contract_id")
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  role          String   @default("") // الدور في المشروع: مدير المشروع / مصمم / مشرف…
  allocationPct Decimal  @default(0) @map("allocation_pct") // نسبة الإخصاص %
  startDate     String   @default("") @map("start_date")
  endDate       String   @default("") @map("end_date")
  status        String   @default("سارية") // سارية | منتهية
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([engineerId])
  @@index([contractId])
  @@map("engineer_assignments")
}

/** ساعات العمل على المشاريع — المخططات والإشراف والمراجعات (ربط العقد اختياري للساعات الإدارية) */
model EngineerTimesheet {
  companyId  Int       @default(1) @map("company_id")
  id         Int       @id @default(autoincrement())
  engineerId Int       @map("engineer_id")
  engineer   Engineer  @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  contractId Int?      @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id])
  workDate   String    @map("work_date") // YYYY-MM-DD
  hours      Decimal   @default(0)
  activity   String    @default("") // تصميم | إشراف | مراجعة | اجتماع | زيارة موقع | إداري
  notes      String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([engineerId, workDate])
  @@index([contractId])
  @@map("engineer_timesheets")
}

/** طلب إجازة مهندس — سير موافقة بسيط: معلقة ثم اعتماد/رفض بسبب موثق */
model EngineerLeave {
  companyId  Int      @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  engineerId Int      @map("engineer_id")
  engineer   Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  leaveType  String   @map("leave_type") // سنوية | مرضية | طارئة | بدون راتب
  startDate  String   @map("start_date") // YYYY-MM-DD
  endDate    String   @map("end_date") // YYYY-MM-DD
  days       Decimal  @default(0)
  status     String   @default("معلقة") // معلقة | معتمدة | مرفوضة
  reason     String   @default("")
  decisionBy String   @default("") @map("decision_by")
  decisionAt String   @default("") @map("decision_at")
  decisionNote String @default("") @map("decision_note") // سبب الرفض/ملاحظة الاعتماد — توثيق إلزامي عند الرفض
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([engineerId, status])
  @@map("engineer_leaves")
}

/// رادار المواعيد — حجز خانة زمنية لمهندس (بند NOVA 4 — سلوتس مشتقة من إعدادات الدوام)
model EngineerAppointment {
  companyId       Int       @default(1) @map("company_id")
  id              Int       @id @default(autoincrement())
  engineerId      Int       @map("engineer_id")
  engineer        Engineer  @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  appointmentDate String    @map("appointment_date") // YYYY-MM-DD
  hourSlot        String    @map("hour_slot") // HH:mm — داخل نطاق دوام الشركة
  customerId      Int?      @map("customer_id")
  customer        Customer? @relation("EngineerAppointmentCustomer", fields: [customerId], references: [id])
  contractId      Int?      @map("contract_id")
  contract        Contract? @relation("EngineerAppointmentContract", fields: [contractId], references: [id])
  note            String    @default("")
  createdBy       String    @default("") @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([appointmentDate, hourSlot, engineerId])
  @@index([engineerId, appointmentDate])
  @@map("engineer_appointments")
}

/**
 * دورة مراجعة مخطط (docs/revisions-ipc-design.md §1) — بند 1 من خريطة NOVA:
 * كل صف = إصدار واحد لمخطط (title) على عقد — revNo يُرقَّم خادميًا لكل (عقد، عنوان)
 * بلا قيد فريد (النص الحر لا يُحاصَر) — آلة حالات مغلقة G7:
 * «بانتظار مراجعة» ⇐ (مقبول | معاد بتعديلات) — القرار نهائي (لا تعديل ولا حذف بعده)
 * وملاحظة الإرجاع إلزامية (نمط إجازات المهندسين).
 */
model ConsultingRevision {
  companyId   Int      @default(1) @map("company_id")
  id          Int      @id @default(autoincrement())
  contractId  Int      @map("contract_id")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String   // اسم المخطط/الوثيقة — مفتاح التجميع بين الإصدارات
  revNo       Int      @map("rev_no") // يُرقَّم خادميًا max+1 لكل (عقد، عنوان)
  status      String   @default("بانتظار مراجعة") // بانتظار مراجعة | مقبول | معاد بتعديلات
  engineerId  Int?     @map("engineer_id") // مُعد الإصدار — اختياري
  engineer    Engineer? @relation(fields: [engineerId], references: [id])
  submittedAt String   @default("") @map("submitted_at") // YYYY-MM-DD تاريخ رفع الإصدار
  decidedAt   String   @default("") @map("decided_at")
  decidedBy   String   @default("") @map("decided_by")
  decisionNote String  @default("") @map("decision_note") // إلزامي عند «معاد بتعديلات»
  notes       String   @default("")
  createdBy   String   @default("") @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([contractId])
  @@index([status])
  @@map("consulting_revisions")
}

// ============================================================
// HR-1 — موديول الموارد البشرية (docs/hr-module-design.md §3.2)
// الموظف الموحد = توسعة employees · خط أنابيب واحد: مسير → قيد (5210/2160) → PV
// ============================================================

/// الحضور اليومي — يدوي أو مستورد من البصمة (HR-2) — الدقائق تُحسب آليًا من جدول الدوام
model EmployeeAttendance {
  companyId         Int      @default(1) @map("company_id")
  id                Int      @id @default(autoincrement())
  employeeId        Int      @map("employee_id")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate          String   @map("work_date") // YYYY-MM-DD
  status            String   @default("present") // present | absent | justified_absent | leave | holiday
  checkIn           String   @default("") @map("check_in") // HH:MM
  checkOut          String   @default("") @map("check_out")
  lateMinutes       Int      @default(0) @map("late_minutes") // دقائق تأخير بعد السماحية — محسوبة آليًا من جدول الدوام
  earlyLeaveMinutes Int      @default(0) @map("early_leave_minutes") // دقائق انصراف مبكر بعد السماحية
  source            String   @default("manual") // manual | import — يحكم أولوية الاستيراد (د7)
  note              String   @default("")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([companyId, employeeId, workDate])
  @@index([workDate])
  @@map("employee_attendance")
}

/// إجازات الموظفين — آلة حالات قانونية: معلقة → معتمدة → بدأت → منتهية (رفض من معلقة بقرار موثق)
model EmployeeLeave {
  companyId    Int      @default(1) @map("company_id")
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    String   @map("leave_type") // سنوية | مرضية | طارئة | بدون راتب
  startDate    String   @map("start_date") // YYYY-MM-DD
  endDate      String   @map("end_date")   // YYYY-MM-DD — شاملة الطرفين
  days         Decimal  @default(0) // حساب آلي بالنواة النقية
  status       String   @default("معلقة") // معلقة | معتمدة | بدأت | منتهية | مرفوضة
  sickTier     Int?     @map("sick_tier") // شريحة المرضية القانونية (0..4) — عرض وتحذير في HR-1
  decisionBy   String   @default("") @map("decision_by")
  decisionAt   String   @default("") @map("decision_at")
  decisionNote String   @default("") @map("decision_note") // إلزامي عند الرفض
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([employeeId, status])
  @@index([status, startDate])
  @@map("employee_leaves")
}

/// أذونات التأخير والانصراف المبكر (HR-2) — آلة أخف من الإجازات: معلقة → معتمدة | مرفوضة
/// الإذن لا ينشئ سجل حضور — هو مُعفٍ من الخصم الدقائقي (د3 من docs/hr-2-design.md)
model EmployeePermission {
  companyId    Int      @default(1) @map("company_id")
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permDate     String   @map("perm_date") // YYYY-MM-DD
  kind         String   @map("kind") // late | early
  minutes      Int      @default(0) // المدة المعلنة للإذن — سقف الإعفاء لليوم
  reason       String   @default("") // العلة — إلزامية
  status       String   @default("معلقة") // معلقة | معتمدة | مرفوضة
  decisionBy   String   @default("") @map("decision_by")
  decisionAt   String   @default("") @map("decision_at")
  decisionNote String   @default("") @map("decision_note") // إلزامي عند الرفض
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([employeeId, status])
  @@index([permDate, status])
  @@map("employee_permissions")
}

/// مسير الرواتب الشهري — لقطة مجمّدة: شهر واحد بحالة نشطة (مسودة/معتمد/مدفوع)
model PayrollBatch {
  companyId        Int      @default(1) @map("company_id")
  id               Int      @id @default(autoincrement())
  batchNo          Int      @default(0) @map("batch_no") // تسلسلي عرضي PR-####
  month            String // YYYY-MM
  status           String   @default("draft") // draft | approved | paid | cancelled
  grossTotal       Decimal  @default(0) @db.Decimal(18, 3) @map("gross_total")
  deductionTotal   Decimal  @default(0) @db.Decimal(18, 3) @map("deduction_total")
  advanceTotal     Decimal  @default(0) @db.Decimal(18, 3) @map("advance_total")
  netTotal         Decimal  @default(0) @db.Decimal(18, 3) @map("net_total")
  journalEntryId   Int?     @map("journal_entry_id") // قيد الاعتماد: مدين 5210 / دائن 2160 + 1140 عبر سندات SD
  journalEntry     JournalEntry? @relation("PayrollBatchEntry", fields: [journalEntryId], references: [id])
  provisionEntryId Int?     @map("provision_entry_id") // HR-2 — قيد المخصصات المصاحب: مدين 5210/5211 · دائن 2161/2211
  provisionEntry   JournalEntry? @relation("PayrollBatchProvisionEntry", fields: [provisionEntryId], references: [id])
  paymentVoucherId Int?     @map("payment_voucher_id") // سند PV للدفع من 2160
  paymentVoucher   Voucher? @relation("PayrollPaymentVoucher", fields: [paymentVoucherId], references: [id])
  generatedBy      String   @default("") @map("generated_by")
  generatedAt      DateTime? @map("generated_at")
  approvedBy       String   @default("") @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  paidAt           DateTime? @map("paid_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String   @default("") @map("cancel_reason")
  records          PayrollRecord[]
  laborAllocations LaborAllocation[] // HR-3 — أسطر توزيع تكلفة الشهر (تحليلي — د1)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([month, status])
  @@map("payroll_batches")
}

/// سجل الموظف في المسير — اللقطة المجمّدة (Cost Snapping): لا قراءة من ملف الموظف لاحقًا
model PayrollRecord {
  companyId          Int          @default(1) @map("company_id")
  id                 Int          @id @default(autoincrement())
  batchId            Int          @map("batch_id")
  batch              PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId         Int          @map("employee_id")
  employee           Employee     @relation(fields: [employeeId], references: [id])
  snapName           String       @map("snap_name")
  snapJobTitle       String       @default("") @map("snap_job_title")
  snapPaymentBasis   String       @default("monthly") @map("snap_payment_basis") // monthly | daily
  presentDays        Decimal      @default(0) // أيام الحضور (أساس اليومي + عرض)
  absenceDays        Decimal      @default(0) // غياب غير مبرر + بدون راتب (عرض)
  snapSickDays       Decimal      @default(0) @map("snap_sick_days") // HR-2 — أيام مرضية متقاطعة (عرض)
  snapLateMinutes    Int          @default(0) @map("snap_late_minutes") // HR-2 — ∑ دقائق مجردة بعد الإعفاءات (عرض)
  baseAmount         Decimal      @default(0) @db.Decimal(18, 3) @map("base_amount")
  absenceDeduction   Decimal      @default(0) @db.Decimal(18, 3) @map("absence_deduction")
  sickDeduction      Decimal      @default(0) @db.Decimal(18, 3) @map("sick_deduction") // HR-2 — مرضية بشرائح <100%
  lateDeduction      Decimal      @default(0) @db.Decimal(18, 3) @map("late_deduction") // HR-2 — دقائق مجردة بعد الإعفاءات
  advanceDeduction   Decimal      @default(0) @db.Decimal(18, 3) @map("advance_deduction") // خطة خصم السلف
  netAmount          Decimal      @default(0) @db.Decimal(18, 3) @map("net_amount")
  deductionVoucherId Int?         @map("deduction_voucher_id") // سند SD لخصم السلف (مدين 2160/دائن 1140)

  @@index([batchId])
  @@index([employeeId])
  @@map("payroll_records")
}

/// توثيق نهاية الخدمة (HR-2) — السيناريو + لقطة الحساب + قيد التسوية (نرفض سلوك NovaFlow «حاسبة بلا مستند» — درس G8)
model EmployeeTermination {
  companyId       Int      @default(1) @map("company_id")
  id              Int      @id @default(autoincrement())
  employeeId      Int      @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  endDate         String   @map("end_date") // YYYY-MM-DD
  scenario        String   // انتهاء عقد | استقالة | فصل (م41) | انصراف (م44) | وفاة | زواج | ولادة | اتفاق الطرفين
  serviceYears    Decimal  @default(0) @map("service_years") // لقطة سنوات الخدمة عند الحساب
  wageAtEnd       Decimal  @default(0) @map("wage_at_end") // لقطة آخر أجر أساسي
  eosAmount       Decimal  @default(0) @map("eos_amount") // مكافأة نهاية الخدمة
  leaveEncashment Decimal  @default(0) @map("leave_encashment") // بدل الإجازات غير المستهلكة
  total           Decimal  @default(0) // eos + encashment
  status          String   @default("محسوبة") // محسوبة | مستقرة
  entryId         Int?     @map("entry_id") // قيد التسوية بعد الاستقرار — رابط مطلق
  decidedBy       String   @default("") @map("decided_by")
  decidedAt       String   @default("") @map("decided_at")
  notes           String   @default("")
  cancelReason    String   @default("") @map("cancel_reason") // إلغاء «محسوبة» فقط بسببه
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([status])
  @@map("employee_terminations")
}

/// HR-3 — تدقيق ملف الموظف حقلًا-بحقل (د9) — NovaFlow employeeAuditLogs معرفيًا لا نصيًا
model EmployeeAuditLog {
  companyId  Int      @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field      String   // اسم الحقل المعرفي (salary) — قائمة مغلقة معلنة في hr-constants
  fieldLabel String   @map("field_label") // العنوان العربي لحظة الكتابة (لقطة)
  oldValue   String   @default("") @map("old_value") // قيمة منسقة نصيًا (نموذج جديد أو «فراغ»)
  newValue   String   @default("") @map("new_value")
  editedBy   String   @map("edited_by")
  editedAt   DateTime @default(now()) @map("edited_at")

  @@index([employeeId, editedAt])
  @@map("employee_audit_logs")
}

/// HR-3 — فريق عمل تشغيلي (د6) — توليد تكليفات جماعية وفلترة عرض، بلا أثر مالي مباشر
model WorkTeam {
  companyId Int      @default(1) @map("company_id")
  id        Int      @id @default(autoincrement())
  name      String
  active    Boolean  @default(true)
  notes     String   @default("")
  members   WorkTeamMember[]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@map("work_teams")
}

/// عضو الفريق — فريد ثنائي، حذف الفريق/الموظف يجرف العضوية
model WorkTeamMember {
  companyId  Int      @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  teamId     Int      @map("team_id")
  team       WorkTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@map("work_team_members")
}

/// HR-3 — تكليف موظف بعقد — مرآة EngineerAssignment حرفيًا (نمط مجرّب داخليًا)
model EmployeeAssignment {
  companyId     Int      @default(1) @map("company_id")
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId    Int      @map("contract_id")
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  role          String   @default("")
  allocationPct Decimal  @default(100) @map("allocation_pct") // النسبة الافتراضية عند توليد التخصيص
  startDate     String   @default("") @map("start_date")
  endDate       String   @default("") @map("end_date")
  status        String   @default("سارية") // سارية | منتهية
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([employeeId, status])
  @@index([contractId])
  @@map("employee_assignments")
}

/// HR-3 — سطر التوزيع الشهري المجمّد — طبقة تحليلية بلا قيد (د1) بSnapshot (Cost Snapping)
/// غير الموزع لا يُخزّن — يُحسب: rate×100% − ∑ الأسطر
model LaborAllocation {
  companyId       Int          @default(1) @map("company_id")
  id              Int          @id @default(autoincrement())
  batchId         Int          @map("batch_id")
  batch           PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId      Int          @map("employee_id")
  employee        Employee     @relation(fields: [employeeId], references: [id])
  contractId      Int          @map("contract_id")
  contract        Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sharePercent    Decimal      @default(0) @map("share_percent") // نسبة شهر تكلفة الموظف
  snapMonthlyRate Decimal      @default(0) @map("snap_monthly_rate") // لقطة التكلفة لحظة الكتابة
  amount          Decimal      @default(0) @db.Decimal(18, 3) // = rate × share% مجمّد
  note            String       @default("")
  createdBy       String       @default("") @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([batchId, employeeId, contractId])
  @@index([contractId])
  @@index([batchId])
  @@map("labor_allocations")
}

// ==================== موديول المخازن (docs/warehouses-design.md §3) ====================
// دروس G1/G9 المحقّقة: الأرصدة اشتقاقية من الأسطر بلا جدول أرصدة، والانحراف على FK حقيقي boqItemId.
// كل الجداول الأربعة تُسجَّل في TENANT_MODELS/BACKUP_MODELS بنفس الـcommit (درس T111).

/** المستودع — بيانات أساسية خفيفة؛ ذو حركة لا يُحذف (تعطيل فقط) */
model Warehouse {
  companyId  Int         @default(1) @map("company_id")
  id         Int         @id @default(autoincrement())
  name       String
  location   String      @default("")
  active     Boolean     @default(true) // التعطيل يخفيه من الأذون الجديدة
  notes      String      @default("")
  createdAt  DateTime    @default(now()) @map("created_at")
  sourceDocs StockDoc[]  @relation("StockDocSource")
  targetDocs StockDoc[]  @relation("StockDocTarget")

  @@unique([companyId, name])
  @@map("warehouses")
}

/** الصنف — تسمية StockItem لتفادي التصادم مع BoqItem التعاقدي؛ ذو حركة لا يُحذف (تعطيل فقط) */
model StockItem {
  companyId Int            @default(1) @map("company_id")
  id        Int            @id @default(autoincrement())
  name      String
  unit      String         @default("") // وحدة قياس نصية للعرض (كيس/م/م²/كجم…) — بلا تحويلات وحدات
  category  String         @default("")
  minQty    Decimal        @default(0) @db.Decimal(18, 3) @map("min_qty") // حد تنبيه عرض فقط (شارة تحت الحد الأدنى)
  active    Boolean        @default(true)
  notes     String         @default("")
  createdAt DateTime       @default(now()) @map("created_at")
  docLines  StockDocLine[]
  invoiceItems InvoiceItem[] // بنود الفواتير المخزنية (المبيعات — علاقة عكسية)

  @@unique([companyId, name])
  @@map("stock_items")
}

/** رأس الإذن — الأنواع الأربعة جميعها بنية واحدة (د3): إدخال·صرف·تحويل·جرد — الحفظ مرحّل بقيد فوري (د6) */
model StockDoc {
  companyId         Int           @default(1) @map("company_id")
  id                Int           @id @default(autoincrement())
  docNumber         String        @map("doc_number") // WI/WO/WT/WC-#### عبر nextNumber (د5)
  kind              String        // entry | issue | transfer | count — قيم معرفية بجداول ثابتة (G7)
  entrySource       String        @default("") @map("entry_source") // entry فقط: cash | credit | return (د11)
  vdate             String        // YYYY-MM-DD
  warehouseId       Int           @map("warehouse_id")
  warehouse         Warehouse     @relation("StockDocSource", fields: [warehouseId], references: [id])
  targetWarehouseId Int?          @map("target_warehouse_id")
  targetWarehouse   Warehouse?    @relation("StockDocTarget", fields: [targetWarehouseId], references: [id])
  contractId        Int?          @map("contract_id")
  contract          Contract?     @relation(fields: [contractId], references: [id]) // الصرف/المرتجع إلزاميان بعقد واحد (د7 — G8)
  party             String        @default("") // اسم المورد نص حر (د11)
  payAccountId      Int?          @map("pay_account_id")
  payAccount        Account?      @relation(fields: [payAccountId], references: [id])
  payAccountName    String        @default("") @map("pay_account_name") // لقطة اسم حساب الدفع
  journalEntryId    Int?          @map("journal_entry_id")
  journalEntry      JournalEntry? @relation("StockDocEntry", fields: [journalEntryId], references: [id]) // القيد المرتبط (نمط السندات)
  // موديول المبيعات (docs/sales-design.md §3): إذن الصرف الآلي للبيع — مرتبط بفاتورة بلا عقد، وSetNull مع حذف الفاتورة
  saleInvoiceId     Int?          @map("sale_invoice_id")
  saleInvoice       Invoice?      @relation("SaleInvoiceDocs", fields: [saleInvoiceId], references: [id])
  totalAmount       Decimal       @default(0) @db.Decimal(18, 3) @map("total_amount") // مجمّد على الرأس لحظة الحفظ
  status            String        @default("posted") // posted | cancelled — لا مسودات (د6)
  cancelReason      String        @default("") @map("cancel_reason")
  cancelledAt       DateTime?     @map("cancelled_at")
  notes             String        @default("")
  createdBy         String        @default("") @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at")
  lines             StockDocLine[]
  workOrders        WorkOrder[] // أوامر الصيانة المرتبطة بهذا الإذن (docs/maintenance-design.md د8)

  @@unique([companyId, docNumber])
  @@index([companyId, kind])
  @@index([warehouseId])
  @@index([contractId])
  @@index([vdate])
  @@map("stock_docs")
}

/** سطر الإذن — اللقطات هنا (د2): تكلفة ومبلغ يجفّفان لحظة الحفظ ولا يُقرآن من أي مصدر لاحقًا */
model StockDocLine {
  companyId    Int       @default(1) @map("company_id")
  id           Int       @id @default(autoincrement())
  docId        Int       @map("doc_id")
  doc          StockDoc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  itemId       Int       @map("item_id")
  item         StockItem @relation(fields: [itemId], references: [id])
  boqItemId    Int?      @map("boq_item_id")
  boqItem      BoqItem?  @relation(fields: [boqItemId], references: [id]) // ربط بند الكميات — تقرير الانحراف (د7 — G1)
  qty          Decimal   @db.Decimal(18, 3) // الجرد: الفرق المقيّد (±) — الأنواع الأخرى موجبة
  countedQty   Decimal   @default(0) @db.Decimal(18, 3) @map("counted_qty") // الجرد: المفحوص توثيقًا فقط
  snapUnitCost Decimal   @db.Decimal(18, 3) @map("snap_unit_cost") // لقطة التكلفة لحظة الحفظ (د2)
  amount       Decimal   @db.Decimal(18, 3) // = r3(qty × snapUnitCost) مجمّد
  note         String    @default("")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([docId])
  @@index([itemId])
  @@index([boqItemId])
  @@map("stock_doc_lines")
}

// ==================== موديول الصيانة والتشغيل (docs/maintenance-design.md §3) ====================
// موديول تشغيلي صافٍ: صفر قيود وصفر حسابات — كل المال عبر محركات الفواتير والسندات والمخازن القائمة.
// درس G9 ثالثًا: حالة الحدث اشتقاقية من أمره + علم تخطٍّ صريح — لا أعمدة حالة مخزنة ولا عدادات.
// الجداول الثلاثة تُسجَّل في TENANT_MODELS/BACKUP_MODELS بنفس الـcommit (درس T111) بالترتيب الطوبولوجي:
// maintenance_plans (بعد contracts) ⇐ maintenance_occurrences ⇐ work_orders (بعد invoices/stock_docs لارتباطاته).

/** خطة الصيانة الوقائية (د5) — مولِّد لا تقويم: فاصل شهري + عدد زيارات ⇒ أحداث بتواريخ معايرة نهاية الشهر */
model MaintenancePlan {
  companyId        Int      @default(1) @map("company_id")
  id               Int      @id @default(autoincrement())
  contractId       Int      @map("contract_id")
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade) // عقد صيانة موسوم حصرًا (د2 — G8)
  name             String   @default("") // «زيارات شهرية 2025» — عرض فقط
  intervalMonths   Int      @map("interval_months") // من {1,2,3,6,12} — تحقق مغلق (د5)
  occurrencesCount Int      @map("occurrences_count") // 1..60 — سقف سلامة
  startDate        String   @map("start_date") // YYYY-MM-DD — نقطة الارتكاز الأولى
  active           Boolean  @default(true) // تعطيل الخطة يوقف مؤشر «متأخر» لأحداثها
  notes            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  occurrences      MaintenanceOccurrence[]

  @@index([contractId])
  @@map("maintenance_plans")
}

/** الحدث الوقائي (د6) — تاريخ فقط، وحالته اشتقاقية من وجود أمره وحالته + علم تخطٍّ صريح (لا عمود حالة مخزن — G9) */
model MaintenanceOccurrence {
  companyId Int             @default(1) @map("company_id")
  id        Int             @id @default(autoincrement())
  planId    Int             @map("plan_id")
  plan      MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueDate   String          @map("due_date") // YYYY-MM-DD — معاير لنهاية الشهر
  skipped   Boolean         @default(false) // علم «متخطاة» الصريح (د6)
  note      String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  workOrder WorkOrder? // علاقة عكسية — الفريد على جهة الأمر (حدث واحد ⇒ أمر واحد)

  @@unique([planId, dueDate])
  @@index([planId])
  @@map("maintenance_occurrences")
}

/** أمر العمل (د3) — وحدة تشغيل بلا أسطر: المواد إذن صرف مخزني مرتبط والفاتورة فاتورة قائمة مرتبطة (د8/د9) */
model WorkOrder {
  companyId      Int      @default(1) @map("company_id")
  id             Int      @id @default(autoincrement())
  docNumber      String   @map("doc_number") // MO-#### عبر nextNumber لكل شركة (د10 — متميز عن WO- المخزني)
  title          String // «صيانة تكييف — فيلا السالم»
  description    String   @default("")
  contractId     Int      @map("contract_id")
  contract       Contract @relation(fields: [contractId], references: [id]) // عقد صيانة نشط حصرًا (د2 — G8)
  occurrenceId   Int?     @unique @map("occurrence_id") // من حدث وقائي — اختياري (أوامر مباشرة ممكنة)
  occurrence     MaintenanceOccurrence? @relation(fields: [occurrenceId], references: [id])
  technicianId   Int?     @map("technician_id")
  technician     VisitStaff? @relation(fields: [technicianId], references: [id]) // د7 — عرض وتقويم فقط، لا payroll
  scheduledDate  String   @default("") @map("scheduled_date") // YYYY-MM-DD
  status         String   @default("مفتوحة") // مفتوحة|جارية|منجزة|ملغاة — آلة مغلقة (د4 — G7)
  completedAt    String   @default("") @map("completed_at") // يثبت عند الإنهاء حصرًا
  completedNote  String   @default("") @map("completed_note")
  cancelReason   String   @default("") @map("cancel_reason")
  cancelledAt    String   @default("") @map("cancelled_at")
  invoiceId      Int?     @map("invoice_id")
  invoice        Invoice? @relation(fields: [invoiceId], references: [id]) // فاتورة الزيارة — بعد الإنهاء حصرًا (د9)
  materialsDocId Int?     @map("materials_doc_id")
  materialsDoc   StockDoc? @relation(fields: [materialsDocId], references: [id]) // إذن الصرف المخزني — بمحرك المخازن حرفًا (د8)
  notes          String   @default("")
  createdBy      String   @default("") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([companyId, docNumber])
  @@index([contractId])
  @@index([status])
  @@index([scheduledDate])
  @@map("work_orders")
}
