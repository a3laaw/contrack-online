}

model PaymentMethod {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  feeType  String  @default("amount") @map("fee_type") // amount|percent
  feeValue Decimal @default(0) @map("fee_value")
  isActive Boolean @default(true) @map("is_active")

