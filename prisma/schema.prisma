  @@index([subContractId])
  @@map("sub_payment_plan")
}

model SubPaymentSource {
  companyId Int @default(1) @map("company_id")
  id         Int                @id @default(autoincrement())
  subLineId  Int                @map("sub_line_id")
  subLine    SubPaymentPlanItem @relation(fields: [subLineId], references: [id], onDelete: Cascade)
  custLineId Int                @map("cust_line_id")
  custLine   PaymentPlanItem    @relation(fields: [custLineId], references: [id], onDelete: Cascade)

  @@unique([subLineId, custLineId])
  @@map("sub_payment_sources")
}

// ==================== أنواع العقود وقوالبها ====================

model ContractType {
  companyId Int @default(1) @map("company_id")
  id               Int                   @id @default(autoincrement())
  name String 
  /** Task 95 — تصنيف النوع: يُختار من قائمة مشتقة تلقائيًا من الأنواع نفسها (بلا كتابة حرة في شاشة الإنشاء) */
  category         String                @default("") @map("category")
  defaultAmount    Decimal               @default(0) @map("default_amount")
  notes            String                @default("")
  active           Boolean               @default(true)
  manualTrack      Boolean               @default(false) @map("manual_track")
  unitLabel        String                @default("") @map("unit_label")
  unitPrice        Decimal               @default(0) @map("unit_price")
  pricingMode      String                @default("lump") @map("pricing_mode") // lump|unit|items|bundle
  isSupervision    Boolean               @default(false) @map("is_supervision")
  isMaintenance    Boolean               @default(false) @map("is_maintenance") // موديول الصيانة (docs/maintenance-design.md د2) — مرآة isSupervision: أقسام الموديول لا ترى غير الموسوم
  paymentTemplates TypePaymentTemplate[]
  bundleParents    TypeBundleComponent[] @relation("bundleParent")
  bundleComponents TypeBundleComponent[] @relation("bundleComponent")

  @@unique([companyId, name])
  @@map("contract_types")
}

model TypePaymentTemplate {
  companyId Int @default(1) @map("company_id")
  id             Int                @id @default(autoincrement())
  contractTypeId Int                @map("contract_type_id")
  contractType   ContractType       @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)
  payNo          Int                @map("pay_no")
  title          String             @default("")
  pct            Decimal            @default(0)
  amountFixed    Decimal            @default(0) @map("amount_fixed")
  triggerStageId Int?               @map("trigger_stage_id")
  triggerStage   WorkflowStage?     @relation("paymentTrigger", fields: [triggerStageId], references: [id], onDelete: SetNull)
  daysOffset     Int                @default(0) @map("days_offset")
  linkKeyword    String             @default("") @map("link_keyword")
  stageLinks     TypePaymentStage[]

  @@unique([contractTypeId, payNo])
  @@map("type_payment_tpl")
}

model TypePaymentStage {
  companyId Int @default(1) @map("company_id")
  id        Int                 @id @default(autoincrement())
  paymentId Int                 @map("payment_id")
  payment   TypePaymentTemplate @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  stageId   Int                 @map("stage_id")
  stage     WorkflowStage       @relation(fields: [stageId], references: [id])

  @@unique([stageId])
  @@map("type_payment_stages")
}

model TypeBundleComponent {
  companyId Int @default(1) @map("company_id")
  id              Int          @id @default(autoincrement())
  parentTypeId    Int          @map("parent_type_id")
  parentType      ContractType @relation("bundleParent", fields: [parentTypeId], references: [id], onDelete: Cascade)
  componentTypeId Int          @map("component_type_id")
  componentType   ContractType @relation("bundleComponent", fields: [componentTypeId], references: [id])
  qty             Decimal      @default(1)

  @@index([parentTypeId])
  @@map("type_bundle_components")
}

// G6 — لقطة مكوّنات العقد الشامل لكل عقد (المكتبي contract_components 1795–1808)
model ContractComponent {
  companyId Int @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  compKey    String   @map("comp_key")
  label      String   @default("")
  kind       String   @default("qty") // qty | months
  enabled    Boolean  @default(true)
  qty        Decimal  @default(1) @db.Decimal(18, 3)
  months     Int      @default(0)
  monthly    Decimal  @default(0) @db.Decimal(18, 3)

  @@unique([contractId, compKey])
  @@map("contract_components")
}

// G7 — نسخة احتياطية قبل الإلغاء (المكتبي entity_backups 290–326) — لا حذف أبدًا
model EntityBackup {
  companyId Int @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type") // contract | sub_contract | claim | custody
  entityId   Int      @map("entity_id")
  backupData String   @map("backup_data") // JSON كامل للسجل قبل الإلغاء
  createdBy  String   @default("") @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("entity_backups")
}

model WorkflowStage {
  companyId Int @default(1) @map("company_id")
  id                      Int                   @id @default(autoincrement())
  transactionType         String                @map("transaction_type") // contract|payment|subcontract|customer
  stageName               String                @map("stage_name")
  stageOrder              Int                   @default(0) @map("stage_order")
  color                   String                @default("#3B82F6")
  parentId                Int?                  @map("parent_id")
  parent                  WorkflowStage?        @relation("tree", fields: [parentId], references: [id])
  children                WorkflowStage[]       @relation("tree")
  expectedDays            Int                   @default(0) @map("expected_days")
  isPreContract           Boolean               @default(false) @map("is_pre_contract")
  contractType            String                @default("") @map("contract_type") // '' = القالب العام
  paymentPct              Decimal               @default(0) @map("payment_pct")
  payKind                 String                @default("") @map("pay_kind")
  isSupervision           Boolean               @default(false) @map("is_supervision")
  supMonthly              Decimal               @default(0) @map("sup_monthly")
  componentKey            String                @default("") @map("component_key")
  templateLinks           TypePaymentStage[]
  scopes                  ContractScope[]
  paymentTriggerTemplates TypePaymentTemplate[] @relation("paymentTrigger")

  @@unique([companyId, transactionType, contractType, stageName])
  @@map("workflow_stages")
}

model ContractScope {
  companyId Int @default(1) @map("company_id")
  contractId      Int           @map("contract_id")
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  templateStageId Int           @map("template_stage_id")
  templateStage   WorkflowStage @relation(fields: [templateStageId], references: [id])

  @@id([contractId, templateStageId])
  @@map("contract_scope")
}

// ==================== الإعدادات والمراجع ====================

model Setting {
  companyId             Int      @id @default(1) @map("company_id")
  companyName           String   @default("") @map("company_name")
  companyAddress        String   @default("") @map("company_address")
  companyPhone          String   @default("") @map("company_phone")
  companyEmail          String   @default("") @map("company_email")
  headerTitle           String   @default("نظام إدارة العقود والمحاسبة") @map("header_title")
  currency              String   @default("د.ك")
  companyLicense        String   @default("") @map("company_license") // Task 111 — رقم الترخيص المدني للبيانات الوصفية XBRL
  hrWorkStart           String   @default("08:00") @map("hr_work_start") // HR-2 — بداية الدوام الرسمي
  hrWorkEnd             String   @default("17:00") @map("hr_work_end") // HR-2 — نهاية الدوام الرسمي
  hrGraceMinutes        Int      @default(15) @map("hr_grace_minutes") // HR-2 — سماحية اليوم بالدقائق (د3)
  entryApprovalMode     Boolean  @default(false) @map("entry_approval_mode") // Task 112 — وضع الاعتماد: قيود المحاسب تُحفظ مسودة حتى اعتماد المحاسب الرئيسي
  bankFeeAmount         Decimal  @default(0.150) @map("bank_fee_amount")
  bankFeeMethod         String   @default("تحويل بنكي") @map("bank_fee_method")
  bankFeeEnabled        Boolean  @default(true) @map("bank_fee_enabled")
  cashflowEnabled       Boolean  @default(true) @map("cashflow_enabled")
  openingBalanceBank    Decimal  @default(0) @map("opening_balance_bank")
  openingBalanceCash    Decimal  @default(0) @map("opening_balance_cash")
  openingBalanceDate    String   @default("") @map("opening_balance_date")
  cashStartDate         String   @default("") @map("cash_start_date")
  subPayClientGate      Boolean  @default(true) @map("sub_pay_client_gate")
  collectionAlertDays   Int      @default(30) @map("collection_alert_days")
  expiryAlerts          String   @default("90,60,30,7") @map("expiry_alerts")
  descPrefixReceipt     String   @default("") @map("desc_prefix_receipt")
  descPrefixSupervision String   @default("") @map("desc_prefix_supervision")
  descPrefixTransfer    String   @default("") @map("desc_prefix_transfer")
  descPrefixCustody     String   @default("") @map("desc_prefix_custody")
  descPrefixStageNote   String   @default("") @map("desc_prefix_stage_note")
  autoBackupEnabled     Boolean  @default(true) @map("auto_backup_enabled")
  autoBackupInterval    Int      @default(24) @map("auto_backup_interval")
  uiTheme               String   @default("light") @map("ui_theme")
  uiPrefs               String?  @map("ui_prefs")
