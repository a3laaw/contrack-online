model PaymentMethod {
  companyId Int @default(1) @map("company_id")
  id       Int     @id @default(autoincrement())
  name String 
  feeType  String  @default("amount") @map("fee_type") // amount|percent
  feeValue Decimal @default(0) @map("fee_value")
  isActive Boolean @default(true) @map("is_active")
  hrEmployees Employee[] @relation("EmployeePaymentMethod") // HR-1 — وسيلة دفع الموظف

  @@unique([companyId, name])
  @@map("payment_methods")
}

// Task 105 — أُسقطت شجرة ExpenseAccount نهائيًا (منهج النواة الواحدة: دليل واحد):
// أُرشفت إلى db/expense-accounts-tree-archive-task105.json، حُمّلت إلى Account
// (مصروف → 5xxx، عُهد/سلف → أصول 1xxx بـaccountRole=custody) وتقرير الدمج
// في db/expense-tree-migration-report-task105.json.

// ==================== المحاسبة الكاملة — دليل الحسابات (Task 102) ====================
// الشجرة الكاملة لكل شركة — الأرضية للقيود المزدوجة (Task 104) والقوائم المالية
// والتوافق مع XBRL الكويتي (هدف أساسي): كل حساب يحمل خريطته لعنصر الـtaxonomy.
// طبيعة الرصيد الطبيعية: asset/expense = مدين، liability/equity/revenue = دائن،
// مع استثناء الحسابات المخالفة (مجمع الإهلاك أصل بطبيعة دائنة).
model Account {
  companyId      Int       @default(1) @map("company_id")
  id             Int       @id @default(autoincrement())
  code           String               // رقم الحساب الهيكلي (فريد لكل شركة) — 1xxx أصول، 2xxx التزامات، 3xxx حقوق ملكية، 4xxx إيرادات، 5xxx مصروفات
  name           String
  type           String               // asset | liability | equity | revenue | expense
  nature         String   @default("debit") @map("nature") // debit | credit — طبيعة الرصيد
  parentId       Int?     @map("parent_id")
  parent         Account? @relation("accTree", fields: [parentId], references: [id])
  children       Account[] @relation("accTree")
  isLeaf         Boolean  @default(true) @map("is_leaf") // ورقة تستقبل قيودًا أم عقدة إجمالية
  allowPosting   Boolean  @default(true) @map("allow_posting")
  isActive       Boolean  @default(true) @map("is_active")
  isSystem       Boolean  @default(false) @map("is_system") // نظامي مُبذّر: لا يُحذف ولا يتغير كوده/نوعه
  // Task 105 — خصائص الشجرة الموحدة المنقولة من ExpenseAccount عند دمجها وإسقاطها:
  // • accountRole: عهد/سلف الموظفين (بديل accountKind='advance') — تُعرض في شاشات العهد وتُستخدم في سندات التسليم/التصفية
  // • includeInProfitability: تستهلكها تقارير ربحية العقود (استبعاد الصرف غير الربحي)
  accountRole            String   @default("standard") @map("account_role") // standard | custody
  includeInProfitability Boolean  @default(true) @map("include_in_profitability")
  openingBalance Decimal  @default(0) @db.Decimal(18, 3) @map("opening_balance") // مدين موجب / دائن سالب (Task 103)
  notes          String   @default("")
  sortOrder      Int      @default(0) @map("sort_order")
  xbrlElement    String   @default("") @map("xbrl_element") // خريطة عنصر taxonomy الكويتي/IFRS — فارغ = غير موصول
  cashFlowKind   String   @default("") @map("cash_flow_kind") // Task 110 — تصنيف التدفق النقدي للحساب (طرف مقابل النقد): "" | operating | investing | financing — الفارغ يُشتق من القسم هيكليًا
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  journalLines   JournalLine[]
  vouchers       Voucher[] @relation("VoucherAccount")
  custodyVouchers Voucher[] @relation("VoucherCustodyAccount")
  bankMaps       BankMap[]   // Task 113 — مفاتيح كشوف البنك المرتبطة بهذا الحساب
  bankRecons     BankRecon[] // Task 113 — إقفالات التسوية البنكية الموثقة
  stockPayDocs   StockDoc[]  // المخازن — أذون الإدخال النقدي الذي دفع من هذا الحساب (docs/warehouses-design.md §3)

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("accounts")
}

// ==================== التسوية البنكية (Task 113) ====================
// خريطة مفتاح كشف البنك (bank_lines.bank_account) → حساب البنك في الدليل — مرة واحدة لكل مفتاح
model BankMap {
  companyId Int       @default(1) @map("company_id")
  id        Int       @id @default(autoincrement())
  bankKey   String    @map("bank_key") // قيمة عمود bank_account في bank_lines
  accountId Int       @map("account_id")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([companyId, bankKey])
  @@map("bank_maps")
}

/** إقفال تسوية بنكية موثق — لقطة الفوارق بين كشف البنك ورصيد الدفتر عند تاريخ */
model BankRecon {
  companyId        Int     @default(1) @map("company_id")
  id               Int     @id @default(autoincrement())
  accountId        Int     @map("account_id")
  account          Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asOf             String  @map("as_of") // YYYY-MM-DD
  statementBalance Decimal @db.Decimal(18, 3) @map("statement_balance") // رصيد الكشف المدخل من المستخدم
  bookBalance      Decimal @db.Decimal(18, 3) @map("book_balance") // رصيد الدفتر المحسوب (افتتاحي + حركات منشورة)
  bankOnlyCount    Int     @default(0) @map("bank_only_count") // بنود الكشف غير المسجلة
  bankOnlyTotal    Decimal @default(0) @db.Decimal(18, 3) @map("bank_only_total")
  glOnlyCount      Int     @default(0) @map("gl_only_count") // بنود الدفتر غير الظاهرة بالكشف (عالقة)
  glOnlyTotal      Decimal @default(0) @db.Decimal(18, 3) @map("gl_only_total")
  unexplained      Decimal @default(0) @db.Decimal(18, 3) @map("unexplained") // فرق غير مفسّر — الإقفال يُرفض إن لم يكن صفرًا
  snapshot         Json    @default("{}") // لقطة قوائم الفوارق وقت الإقفال
  closedBy         String  @default("") @map("closed_by")
  closedAt         DateTime @default(now()) @map("closed_at")

  @@unique([companyId, accountId, asOf])
  @@map("bank_recons")
}

// ==================== النواة المحاسبية — القيد المزدوج الحقيقي (Task 104) ====================
// قرار هيكلي صريح (docs/roadmap-accounting.md): الأستاذ العام مصدر الحقيقة الوحيد —
// لا رصيد يُحسب خارج JournalLine. كل مستند (سند/فاتورة/قيد يدوي) يولّد قيدًا متوازنًا إلزاميًا،
// والإلغاء بقيد عكسي مرتبط. العقود/الباطن/مشاريع… أبعاد تحليلية على سطر القيد (بلا FK تشغيلي).

/** السنة المالية — تحكم المدة الزمنية للقيود (الإقفال في Task 109) */
model FiscalYear {
  companyId Int            @default(1) @map("company_id")
  id        Int            @id @default(autoincrement())
  year      Int
  status    String         @default("open") // open | closed
  periods   FiscalPeriod[]
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([companyId, year])
  @@map("fiscal_years")
}

/** الفترة الشهرية — المفتاح "YYYY-MM" يوافق بادئة تواريخ النظام النصية */
model FiscalPeriod {
  companyId    Int        @default(1) @map("company_id")
  id           Int        @id @default(autoincrement())
  fiscalYearId Int        @map("fiscal_year_id")
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  periodDate   String     @map("period_date") // "2025-01"
  status       String     @default("open") // open | closed
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([fiscalYearId, periodDate])
  @@index([companyId, periodDate])
  @@map("fiscal_periods")
}

/**
 * سجل الإقفال السنوي الموثق (Task 109) — كل إقفال سنة مالية يُوثق سجلًا واحدًا لكل شركة وسنة:
 * قيد الإغلاق المرتبط + إجمالي الإيرادات والمصروفات ونتيجة السنة + ميزان افتتاحية السنة التالية
 * (openingSnapshot) لغرض المراجعة — الإعادة للفتح تحوّل الحالة reverted وتلغي قيد الإغلاق
 * إلغاءً موثقًا (بلا حذف فيزيائي — القيد يبقى في السجل بسبب الإلغاء).
 */
model FiscalClosing {
  companyId       Int          @default(1) @map("company_id")
  id              Int          @id @default(autoincrement())
  year            Int
  status          String       @default("closed") // closed | reverted
  closingEntryId  Int?         @unique @map("closing_entry_id")
  closingEntry    JournalEntry? @relation("FiscalClosingEntry", fields: [closingEntryId], references: [id], onDelete: SetNull)
  totalRevenue    Decimal      @default(0) @db.Decimal(18, 3) @map("total_revenue")
  totalExpense    Decimal      @default(0) @db.Decimal(18, 3) @map("total_expense")
  netResult       Decimal      @default(0) @db.Decimal(18, 3) @map("net_result") // موجب = ربح، سالب = خسارة
  linesCount      Int          @default(0) @map("lines_count") // عدد أسطر الإغلاق (بما فيها سطر الأرباح المحتجزة)
  openingSnapshot Json?        @map("opening_snapshot") // ميزان افتتاحية السنة التالية — أرصدة محمولة موثقة
  notes           String       @default("")
  closedBy        String       @map("closed_by")
  closedAt        DateTime     @default(now()) @map("closed_at")
  revertedAt      DateTime?    @map("reverted_at")
  revertReason    String       @default("") @map("revert_reason")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([companyId, year])
  @@index([companyId, status])
  @@map("fiscal_closings")
}

/**
 * إقرار الزكاة/الضريبة السنوي — Task 111.
 * الزكاة 1% (قانون 8/2019 لصندوق الكويت الوطني) وضريبة دخل الأجانب 15% (شركة أجنبية ملكية حصرًا).
 * مصدر الرقم الوحيد: الأستاذ (نتيجة السنة من حركة 4xxx/5xxx المرحّلة — قيود الإغلاق السنوي مستثناة
 * حتى لا تصير النتيجة صفرًا بعد الإقفال). التعديلات «بالنموذج المعلن» تُوثق صفًا صفًا (Json).
 * الاعتماد ينشر قيد المخصص آليًا عبر المحرك الموحد — الإلغاء قيد عكسي موثق بلا حذف فيزيائي.
 */
model TaxDeclaration {
  companyId    Int      @default(1) @map("company_id")
  id           Int      @id @default(autoincrement())
  year         Int
  kind         String   @default("zakat") // zakat (1%) | foreign_tax (15%)
  status       String   @default("draft") // draft | approved | cancelled
  netProfit    Decimal  @db.Decimal(18, 3) @map("net_profit") // نتيجة السنة من الأستاذ لحظة إنشاء المسودة
  adjustments  Json?    // تعديلات النموذج المعلن [{label, amount}] — موجب إضافة / سالب خصم
  base         Decimal  @db.Decimal(18, 3) // الوعاء = صافي الربح + التعديلات (الزكاة لا تقل عن صفر)
  rate         Decimal  @db.Decimal(7, 4) // 0.01 أو 0.15
  amount       Decimal  @db.Decimal(18, 3) // المخصص المحتسب
  entryId      Int?     @map("entry_id")
  entry        JournalEntry? @relation("TaxDeclarationEntry", fields: [entryId], references: [id], onDelete: SetNull)
  notes        String   @default("")
  approvedBy   String   @default("") @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String   @default("") @map("cancel_reason")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId, year])
  @@index([companyId, status])
  @@map("tax_declarations")
}

/**
 * قاعدة ترحيل السندات — قالب القيد الآلي لكل صنف سند (Task 106).
 * قرار هيكلي: قواعد القيد تُعلن ولا تُصلب — لكل شركة نسخها القابلة للضبط،
 * والبذرة النظامية (isSystem) تطابق المنطق المدمج حرفيًا فتعمل الشركة بلا أي ضبط.
 * الحسم عند النشر بأولوية صارمة:
 *   1) اختيار السند الصريح (accountId/custodyAccountId من الدليل الموحد)
 *   2) كود القاعدة القابل للضبط (debitCode/creditCode إن لم يكن فارغًا)
 *   3) الافتراضي المدمج في النواة (posting-rules-core) — شبكة أمان إن كانت
 *      القاعدة معطلة أو كودها فارغًا أو الكود غير موجود في الدليل
 * الأكواد نصية (لا FK) — حسمها إلى id يتكرر عند كل نشر على الدليل الحي،
 * فتظهر القاعدة المتضاربة مع الدليل خطأً واضحًا عند الحفظ لا صمتًا عند النشر.
 */
model PostingRule {
  companyId  Int      @default(1) @map("company_id")
  id         Int      @id @default(autoincrement())
  ruleKey    String   @map("rule_key") // مفتاح من POSTING_RULE_CATALOG (receipt|payment_expense|…)
  label      String   @default("") // التسمية المعروضة عند البذر (تُحدَّث من الكتالوج إن فارغت)
  debitCode  String   @default("") @map("debit_code") // كود حساب الطرف المدين الثابت — فارغ = سياقي
  creditCode String   @default("") @map("credit_code") // كود حساب الطرف الدائن الثابت — فارغ = سياقي
  enabled    Boolean  @default(true) // القاعدة المعطلة ترجع كليًا للافتراضي المدمج
  isSystem   Boolean  @default(true) @map("is_system") // بذرة النظام: تُعدَّل أكوادها ولا تُحذف
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, ruleKey])
  @@map("posting_rules")
}

/** رأس القيد — status: posted (منشور يُحسب في الأرصدة) | draft | cancelled (مُلغى لا يُحسب) */
model JournalEntry {
  companyId    Int            @default(1) @map("company_id")
  id           Int            @id @default(autoincrement())
  entryNo      Int            @default(0) @map("entry_no") // تسلسلي لكل شركة (companyId, entryNo)
  entryDate    String         @map("entry_date")
  description  String         @default("")
  status       String         @default("posted") // posted | draft | cancelled
  sourceType   String         @default("manual") @map("source_type") // manual | voucher | voucher_cancel | bank_fee_alloc | custody | reversal | migration
  sourceId     Int?           @map("source_id")
  reversalOfId Int?           @map("reversal_of_id") // القيد الأصلي عند القيد العكسي
  reversalOf   JournalEntry?  @relation("entryReversal", fields: [reversalOfId], references: [id])
  reversalEntries JournalEntry[] @relation("entryReversal")
  postedAt     DateTime?      @map("posted_at")
  postedBy     String         @default("") @map("posted_by")
  createdBy    String         @default("") @map("created_by")
  cancelReason String         @default("") @map("cancel_reason")
  lines        JournalLine[]
  invoices     Invoice[]     @relation("InvoiceEntry") // فواتير أصدرت هذا القيد (Task 107)
  taxDeclarations TaxDeclaration[] @relation("TaxDeclarationEntry") // مخصصات زكاة/ضريبة وثّقت بهذا القيد (Task 111)
  payrollBatches PayrollBatch[] @relation("PayrollBatchEntry") // HR-1 — مساير اعتمدت بقيد هذا (المدين 5210/الدائن 2160)
  payrollProvisionBatches PayrollBatch[] @relation("PayrollBatchProvisionEntry") // HR-2 — قيود المخصصات المصاحبة
  stockDocs StockDoc[] @relation("StockDocEntry") // المخازن — قيود أذون الإدخال/الصرف/الجرد (docs/warehouses-design.md §5)
  closingRecord FiscalClosing? @relation("FiscalClosingEntry") // إقفال سنوي وثّق بهذا القيد (Task 109)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([companyId, entryNo])
  @@index([entryDate])
  @@index([status])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

/** سطر القيد — طرف واحد مدين أو دائن + الأبعاد التحليلية (بلا FK على التشغيلي عمدًا) */
model JournalLine {
  companyId   Int          @default(1) @map("company_id")
  id          Int          @id @default(autoincrement())
  entryId     Int          @map("entry_id")
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   Int          @map("account_id")
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Decimal      @default(0) @db.Decimal(18, 3)
  credit      Decimal      @default(0) @db.Decimal(18, 3)
  description String       @default("")
  // الأبعاد التحليلية — تقرأ منها تقارير الذمم والربحية (Task 108)
  customerId    Int?    @map("customer_id")
  contractId    Int?    @map("contract_id")
  subContractId Int?    @map("sub_contract_id")
  boqItemId     Int?    @map("boq_item_id")
  projectId     Int?    @map("project_id")
  employeeId    Int?    @map("employee_id")
  costCenter    String  @default("") @map("cost_center")
  sort          Int     @default(0)

  @@index([entryId])
  @@index([accountId])
  @@index([contractId])
  @@map("journal_lines")
}

model ContractGroup {
  companyId Int @default(1) @map("company_id")
  id          Int                 @id @default(autoincrement())
  groupNumber String @map("group_number")
  customerId  Int                 @map("customer_id")
  customer    Customer            @relation(fields: [customerId], references: [id])
  groupName   String              @map("group_name")
  notes       String              @default("")
  status      String              @default("نشط")
  createdBy   String              @default("") @map("created_by")
  items       ContractGroupItem[]
  createdAt   DateTime            @default(now())

  @@unique([companyId, groupNumber])
  @@map("contract_groups")
}

model ContractGroupItem {
  companyId Int @default(1) @map("company_id")
  id         Int           @id @default(autoincrement())
  groupId    Int           @map("group_id")
  group      ContractGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contractId Int           @map("contract_id")
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([groupId, contractId])
  @@map("contract_group_items")
}

// ==================== الفواتير والعهد والموظفون ====================

/**
 * Invoice — Task 107 (استبدال كامل — منهج النواة الواحدة):
 * فاتورة مستندية ببنود وحالة سداد مشتقة، تُصدر قيدًا آليًا إلزاميًا عند الإصدار
 * (مدين ذمم العملاء / دائن إيراد العقود عبر قاعدة invoice_issue المعلنة)،
 * والإلغاء بقيد عكسي مرتبط (لا حذف). السداد مصدره وحيد: سندات القبض عبر
 * InvoicePaymentLink (تخصيص FIFO آلي) — paidAmount حالة مخزنة تُعاد كلها
 * في نفس معاملة تغيّر الروابط (لا مصدر ثانٍ أبدًا).
 * صفوف legacy=true: فواتير ما قبل النواة المزدوجة — أرشيفية بلا قيد،
 * مستبعدة من التخصيص (أموالها حُصّلت بالفعل تحت نموذج النصوص القديم).
 */
model Invoice {
  companyId Int @default(1) @map("company_id")
  id            Int       @id @default(autoincrement())
  invoiceNo     Int       @default(0) @map("invoice_no") // تسلسلي لكل شركة (companyId, invoiceNo)
  invoiceNumber String    @map("invoice_number") // صيغة العرض INV-0001 (عدّاد لا يتراجع)
  customerId    Int       @map("customer_id")
  customer      Customer  @relation(fields: [customerId], references: [id])
  contractId    Int?      @map("contract_id")
  contract      Contract? @relation(fields: [contractId], references: [id])
  invoiceDate   String    @map("invoice_date") // YYYY-MM-DD — تاريخ قيد الإصدار (داخل فترة مفتوحة)
  dueDate       String    @default("") @map("due_date")
  description   String    @default("")
  subtotal      Decimal   @default(0) @db.Decimal(18, 3) // محصلة الكميات×الأسعار قبل الخصم
  discountTotal Decimal   @default(0) @db.Decimal(18, 3) @map("discount_total") // محصلة الخصومات
  total         Decimal   @default(0) @db.Decimal(18, 3) // الصافي المفوتر = subtotal − discountTotal
  paidAmount    Decimal   @default(0) @db.Decimal(18, 3) @map("paid_amount") // من الروابط حصرًا (كاش يُعاد حسابه)
  status        String    @default("unpaid") // unpaid | partial | paid | void
  voidReason    String    @default("") @map("void_reason")
  legacy        Boolean   @default(false) // فاتورة مرحَّلة من هيكل ما قبل Task 107 — بلا قيد
  notes         String    @default("")
  entryId       Int?      @map("entry_id") // قيد الإصدار المرتبط (قيود التعديل تُعكس وتُعاد نشرها)
  entry         JournalEntry? @relation("InvoiceEntry", fields: [entryId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @map("updated_at")
  items         InvoiceItem[]
  paymentLinks  InvoicePaymentLink[]
  saleDocs      StockDoc[] @relation("SaleInvoiceDocs") // أذون الصرف المخزني الآلية للبيع (موديول المبيعات — docs/sales-design.md §3)
  workOrders    WorkOrder[] // فواتير الزيارات المولدة من أوامر الصيانة (docs/maintenance-design.md §3)
  // جسر الإنجاز إلى الفوترة (docs/revisions-ipc-design.md §2) — السطر المثار من إغلاق مرحلة الذي فوترت هذه الفاتورة
  paymentId     Int?       @map("payment_id")
  payment       PaymentPlanItem? @relation(fields: [paymentId], references: [id])

  @@unique([companyId, invoiceNo])
  @@unique([companyId, invoiceNumber])
  @@index([customerId])
  @@index([contractId])
  @@index([status])
  @@index([paymentId])
  @@map("invoices")
}

/** بند الفاتورة — الخصم نسبة % على السطر، والمحصلة على الرأس تتحقق محركًا (لا إدخالًا يدويًا) */
model InvoiceItem {
  companyId Int @default(1) @map("company_id")
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(18, 3)
  unitPrice   Decimal @default(0) @db.Decimal(18, 3) @map("unit_price")
  discountPct Decimal @default(0) @db.Decimal(5, 2) @map("discount_pct") // 0–100
  lineTotal   Decimal @default(0) @db.Decimal(18, 3) @map("line_total") // qty×price×(1−disc)
  sortOrder   Int     @default(0) @map("sort_order")
  // موديول المبيعات (docs/sales-design.md §3): سطر مخزني بـitemId ⇒ صرف آلي بقيد تكلفة المبيعات — الفارغ سطر حر
  itemId      Int?      @map("item_id")
  item        StockItem? @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_items")
}

/**
 * ربط سداد الفواتير بسندات القبض — Task 107: مصدر السداد واحد هو السند
 * (مرآة VoucherPaymentLink لكن على الفواتير — لا يتصادمان لأن lineId لخطط
 * العقود/الباطن وinvoiceId للفواتير بجدولين مستقلين). يُنشأ بالتخصيص الآلي
 * FIFO في معاملة إنشاء/تعديل/إلغاء السند، وpaidAmount يُجمَّع منه حصرًا.
 */
model InvoicePaymentLink {
  companyId Int @default(1) @map("company_id")
  id        Int      @id @default(autoincrement())
  invoiceId Int      @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  voucherId Int      @map("voucher_id")
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(18, 3)
  createdAt DateTime @default(now())

  @@unique([voucherId, invoiceId])
  @@index([invoiceId])
  @@map("invoice_payment_links")
}

model Employee {
  companyId Int @default(1) @map("company_id")
  id       Int       @id @default(autoincrement())
  name String 
  phone    String    @default("")
  notes    String    @default("")
  active   Boolean   @default(true)
  vouchers Voucher[]
  // HR-1 — توسعة «الموظف الموحد» (docs/hr-module-design.md §3.1): نظام السلف القائم يعمل كما هو بلا ترحيل
  jobNumber       String  @default("") @map("job_number") // رقم وظيفي يبدأ من 1001 — توليد آلي
  employeeType    String  @default("internal") @map("employee_type") // internal | external — الخارجي يحرر إلزامية الراتب
  department      String  @default("")
  jobTitle        String  @default("") @map("job_title")
  civilId         String  @default("") @map("civil_id") // الرقم المدني الكويتي 10 أرقام
  nationality     String  @default("")
  hireDate        String  @default("") @map("hire_date") // YYYY-MM-DD — مرجع حساب رصيد الإجازات
  salary          Decimal @default(0) // الأساسي الشهري — صفر = مستثنى من المسير
  paymentBasis    String  @default("monthly") @map("payment_basis") // monthly | daily
  dailyRate       Decimal @default(0) @map("daily_rate") // لأساس الأجر اليومي
  monthlyCostRate Decimal @default(0) @map("monthly_cost_rate") // HR-3 — التكلفة الشهرية على الشركة (د2) — 0 ⇒ افتراضي الراتب الأساسي لحظة التخصيص
  paymentMethodId Int?    @map("payment_method_id")
  paymentMethod   PaymentMethod? @relation("EmployeePaymentMethod", fields: [paymentMethodId], references: [id])
  attendances     EmployeeAttendance[]
  leaves          EmployeeLeave[]
  permissions     EmployeePermission[]
  payrollRecords  PayrollRecord[]
  terminations    EmployeeTermination[]
  // HR-3 — الأطقم والتكليفات والتخصيص وتدقيق الملف
  auditLogs       EmployeeAuditLog[]
  teamMemberships WorkTeamMember[]
  assignments     EmployeeAssignment[]
  laborAllocations LaborAllocation[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("employees")
}

// ==================== الإنتاجية ====================

model Task {
  companyId Int @default(1) @map("company_id")
  id             Int       @id @default(autoincrement())
  title          String
  details        String    @default("")
  dueAt          String    @map("due_at") // YYYY-MM-DD HH:mm
  remindMinutes  Int       @default(30) @map("remind_minutes")
  source         String    @default("يدوية")
  taskType       String    @default("تذكير") @map("task_type") // تذكير|موعد
  status         String    @default("مفتوحة") // مفتوحة|منجزة
  notifiedBefore Boolean   @default(false) @map("notified_before")
  notifiedAfter  Boolean   @default(false) @map("notified_after")
  doneAt         String    @default("") @map("done_at")
  customerId     Int?      @map("customer_id")
  customer       Customer? @relation(fields: [customerId], references: [id])
  contractId     Int?      @map("contract_id")
  contract       Contract? @relation(fields: [contractId], references: [id])
  visits         Visit[]
  createdAt      DateTime  @default(now())

  @@index([status, dueAt])
  @@map("tasks")
}

model VisitStaff {
  companyId Int @default(1) @map("company_id")
  id     Int     @id @default(autoincrement())
  name   String
  phone  String  @default("")
  active Boolean @default(true)
  sort   Int     @default(0)
  visits Visit[]
  workOrders WorkOrder[] // فنيو الصيانة — عرض وتقويم فقط (docs/maintenance-design.md د7)

  @@map("visit_staff")
}

model Visit {
  companyId Int @default(1) @map("company_id")
  id         Int        @id @default(autoincrement())
  visitDate  String     @map("visit_date") // YYYY-MM-DD
  hourSlot   String     @map("hour_slot") // "08:00"
  staffId    Int        @map("staff_id")
  staff      VisitStaff @relation(fields: [staffId], references: [id])
  customerId Int?       @map("customer_id")
