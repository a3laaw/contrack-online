generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== الحوكمة ====================

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  passwordHash String           @map("password_hash")
  salt         String
  role         String           @default("secretary") // admin | secretary | developer
  fullName     String           @default("") @map("full_name")
  jobTitle     String           @default("") @map("job_title")
  active       Boolean          @default(true)
  permissions  UserPermission[]
  dismissedAlerts DismissedAlert[]
  createdQuotations Quotation[] @relation("quotationCreatedBy")
  createdAt    DateTime         @default(now())

  @@map("users")
}

model UserPermission {
  userId  Int     @map("user_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permKey String  @map("perm_key")
  allowed Boolean @default(true)

  @@id([userId, permKey])
  @@map("user_permissions")
}

model FeatureFlag {
  key     String  @id
  enabled Boolean @default(true)

  @@map("feature_flags")
}

model NumberSequence {
  name   String @id
  lastNo Int    @default(0) @map("last_no")

  @@map("number_sequences")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  ts         DateTime @default(now())
  username   String   @default("")
  action     String
  entityType String   @default("") @map("entity_type")
  entityId   Int      @default(0) @map("entity_id")
  entityName String   @default("") @map("entity_name")
  oldStatus  String   @default("") @map("old_status")
  newStatus  String   @default("") @map("new_status")
  reason     String   @default("")

  @@map("audit_log")
}

model PurgeAudit {
  id       Int      @id @default(autoincrement())
  purgedAt DateTime @default(now()) @map("purged_at")
  purgedBy String   @default("") @map("purged_by")
  entity   String
  entityId Int      @default(0) @map("entity_id")
  label    String   @default("")
  reason   String   @default("")
  snapshot String   @default("[]")

  @@map("purge_audit")
}

// ==================== العملاء والعقود ====================

model Customer {
  id             Int             @id @default(autoincrement())
  customerCode   String          @unique @map("customer_code")
  name           String
  phone          String          @default("")
  email          String          @default("")
  governorate    String          @default("")
  area           String          @default("")
  block          String          @default("")
  plot           String          @default("")
  address        String          @default("")
  notes          String          @default("")
  folderPath     String          @default("") @map("folder_path")
  contracts      Contract[]
  tasks          Task[]
  visits         Visit[]
  comments       Comment[]
  invoices       Invoice[]
  createdAt      DateTime        @default(now())
  contractGroups ContractGroup[]
  projects       Project[]
  quotations     Quotation[]

  @@map("customers")
}

model Contract {
  id                Int                  @id @default(autoincrement())
  contractNumber    String               @unique @map("contract_number")
  contractName      String               @default("") @map("contract_name")
  customerId        Int                  @map("customer_id")
  customer          Customer             @relation(fields: [customerId], references: [id])
  contractDate      String               @default("") @map("contract_date")
  description       String               @default("")
  amount            Decimal
  notes             String               @default("")
  contractType      String               @default("غير محدد") @map("contract_type")
  manualPath        Boolean              @default(false) @map("manual_path")
  signDate          String               @default("") @map("sign_date")
  startDate         String               @default("") @map("start_date")
  endDate           String               @default("") @map("end_date")
  status            String               @default("نشط")
  currency          String               @default("د.ك")
  statusReason      String               @default("") @map("status_reason")
  cancelledAt       String               @default("") @map("cancelled_at")
  cancelCloseAmount Decimal              @default(0) @map("cancel_close_amount")
  qty               Decimal              @default(1)
  unitPrice         Decimal              @default(0) @map("unit_price")
  // الإشراف الهندسي
  supStartDate      String               @default("") @map("sup_start_date")
  supMonths         Int                  @default(0) @map("sup_months")
  supMonthly        Decimal              @default(0) @map("sup_monthly")
  supDiscount       Decimal              @default(0) @map("sup_discount")
  supWaivedMonths   Decimal              @default(0) @map("sup_waived_months")
  supWaiveReason    String               @default("") @map("sup_waive_reason")
  stages            ContractStage[]
  plan              PaymentPlanItem[]
  vouchers          Voucher[]
  addendums         Addendum[]
  boqItems          BoqItem[]
  events            ContractEvent[]
  attachments       ContractAttachment[]
  invoices          Invoice[]
  claims            Claim[]
  subContracts      SubContract[]
  tasks             Task[]
  comments          Comment[]
  groupItems        ContractGroupItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  contractScopes    ContractScope[]
  stageNotes        StageNote[]
  txMessages        TxMessage[]

  @@index([customerId, status])
  @@map("contracts")
}

model ContractStage {
  id                Int                  @id @default(autoincrement())
  contractId        Int                  @map("contract_id")
  contract          Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name              String
  level             Int                  @default(1)
  parentName        String               @default("") @map("parent_name")
  expectedDays      Int                  @default(0) @map("expected_days")
  payPct            Decimal              @default(0) @map("pay_pct")
  payKind           String               @default("") @map("pay_kind") // ""|achieve|advance|final|days
  sortOrder         Int                  @default(0) @map("sort_order")
  startDate         String               @default("") @map("start_date")
  endDate           String               @default("") @map("end_date")
  isSkipped         Boolean              @default(false) @map("is_skipped")
  closedBy          String               @default("") @map("closed_by")
  isSupervision     Boolean              @default(false) @map("is_supervision")
  supStart          String               @default("") @map("sup_start")
  supEnd            String               @default("") @map("sup_end")
  supActualEnd      String               @default("") @map("sup_actual_end")
  supMonthly        Decimal              @default(0) @map("sup_monthly")
  supWaivedMonths   Decimal              @default(0) @map("sup_waived_months")
  supWaiveReason    String               @default("") @map("sup_waive_reason")
  deletedAddendumId Int                  @default(0) @map("deleted_addendum_id")
  payments          PaymentPlanItem[]
  boqItems          BoqItem[]
  subPlanLines      SubPaymentPlanItem[]

  @@index([contractId])
  @@map("contract_stages")
}

model BoqItem {
  id                Int               @id @default(autoincrement())
  contractId        Int               @map("contract_id")
  contract          Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stageId           Int?              @map("stage_id")
  stage             ContractStage?    @relation(fields: [stageId], references: [id])
  description       String
  qty               Decimal           @default(1)
  unit              String            @default("")
  unitPrice         Decimal           @default(0) @map("unit_price")
  amount            Decimal           @default(0)
  sortOrder         Int               @default(0) @map("sort_order")
  deleted           Boolean           @default(false)
  deletedAddendumId Int               @default(0) @map("deleted_addendum_id")
  subItems          SubContractItem[]
  addendumItems     AddendumItem[]
  vouchers          Voucher[]

  @@index([contractId])
  @@map("boq_items")
}

model PaymentPlanItem {
  id                Int                @id @default(autoincrement())
  contractId        Int                @map("contract_id")
  contract          Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title             String
  dueDate           String             @map("due_date")
  amount            Decimal
  sortOrder         Int                @default(0) @map("sort_order")
  stageId           Int?               @map("stage_id")
  stage             ContractStage?     @relation(fields: [stageId], references: [id])
  notes             String             @default("")
  triggeredAt       String             @default("") @map("triggered_at") // غير فارغ = استحقاق فعلي
  manualAmount      Boolean            @default(false) @map("manual_amount")
  deletedAddendumId Int                @default(0) @map("deleted_addendum_id")
  subSources        SubPaymentSource[]
  claims            Claim[]
  createdAt         DateTime           @default(now())

  @@index([contractId, dueDate, sortOrder])
  @@map("payment_plan")
}

model Voucher {
  id                     Int                  @id @default(autoincrement())
  voucherNumber          String               @unique @map("voucher_number")
  vtype                  String // payment|receipt|transfer|custody_return|salary_deduction
  vdate                  String
  party                  String               @default("")
  partyType              String               @default("") @map("party_type") // customer|subcontractor|partner|transfer|""
  partyId                Int?                 @map("party_id")
  method                 String               @default("")
  account                String               @default("")
  expenseAccountId       Int?                 @map("expense_account_id")
  expenseAccount         ExpenseAccount?      @relation("expenseAccount", fields: [expenseAccountId], references: [id])
  expenseAccountSnapshot String               @default("") @map("expense_account_snapshot")
  expenseGroupRef        String               @default("") @map("expense_group_ref")
  expenseGroupLine       Int?                 @map("expense_group_line")
  custodyAccountId       Int?                 @map("custody_account_id")
  custodyAccount         ExpenseAccount?      @relation("custodyAccount", fields: [custodyAccountId], references: [id])
  custodyAccountSnapshot String               @default("") @map("custody_account_snapshot")
  advanceEmployeeId      Int?                 @map("advance_employee_id")
  employee               Employee?            @relation(fields: [advanceEmployeeId], references: [id])
  amount                 Decimal
  advanceAmount          Decimal              @default(0) @map("advance_amount")
  description            String               @default("")
  projectId              Int?                 @map("project_id")
  project                Project?             @relation(fields: [projectId], references: [id])
  expenseCustomerId      Int?                 @map("expense_customer_id")
  contractId             Int?                 @map("contract_id")
  contract               Contract?            @relation(fields: [contractId], references: [id])
  boqItemId              Int?                 @map("boq_item_id")
  boqItem                BoqItem?             @relation(fields: [boqItemId], references: [id])
  subContractId          Int?                 @map("sub_contract_id")
  subContract            SubContract?         @relation(fields: [subContractId], references: [id])
  costCenter             String               @default("") @map("cost_center")
  attachment             String               @default("")
  notes                  String               @default("")
  parentVoucherId        Int?                 @map("parent_voucher_id")
  parentVoucher          Voucher?             @relation("feeChildren", fields: [parentVoucherId], references: [id])
  feeChildren            Voucher[]            @relation("feeChildren")
  chequeDueDate          String               @default("") @map("cheque_due_date")
  allocation             String               @default("") // تخصيص لأمر تغييري ADD-xxx
  receiptGroupRef        String               @default("") @map("receipt_group_ref")
  receiptGroupLine       Int?                 @map("receipt_group_line")
  cancelled              Boolean              @default(false)
  cancelReason           String               @default("") @map("cancel_reason")
  cancelledAt            String               @default("") @map("cancelled_at")
  links                  VoucherPaymentLink[]
  gatewayFeeLinks        GatewayFeeVoucher[]
  createdAt              DateTime             @default(now())

  @@index([vtype, cancelled, vdate])
  @@index([contractId])
  @@index([partyType, partyId, vtype, cancelled])
  @@index([custodyAccountId, expenseGroupRef])
  @@index([advanceEmployeeId])
  @@map("vouchers")
}

/**
 * المشاريع — بند 11 من المرحلة 9.
 * مرآة database_schema_postgresql.sql §48 حرفيًا: projects(customer_id CASCADE،
 * name، description، location، start_date، end_date، status افتراضي «جديد»).
 * لا حقول مال في المشاريع (قاعدة المكتبي) — والربط المالي الوحيد vouchers.project_id.
 * ملاحظة موثقة: المكتبي (SQLite) يضيف مشروعًا تلقائيًا لكل عقد عبر contracts.project_id
 * غير الموجودة في مخطط PostgreSQL المرجعي ولا في نموذج الويب — فالمشاريع في الويب
 * كيان مستقل تابع للعميل كما في المخطط المرجعي حرفيًا.
 */
model Project {
  id          Int       @id @default(autoincrement())
  customerId  Int?      @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  location    String    @default("")
  startDate   String    @default("") @map("start_date")
  endDate     String    @default("") @map("end_date")
  status      String    @default("جديد")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  vouchers    Voucher[]
  quotations  Quotation[]

  @@index([customerId])
  @@map("projects")
}

/**
 * عروض الأسعار — بند 12 من المرحلة 9.
 * مرآة database_schema_postgresql.sql §49-50 حرفيًا: quotations(customer_id
 * ON DELETE RESTRICT · project_id ON DELETE SET NULL · quotation_number UNIQUE ·
 * total_amount · status DEFAULT 'جديد' بقيم «جديد/مرسل/مقبول/مرفوض/منتهي» ·
 * valid_until · notes · created_by) وquotation_items(quotation_id CASCADE ·
 * وصف · وحدة · كمية · سعر · إجمالي البند = كمية×سعر · sort_order).
 * ملاحظات نطاق موثقة: المكتبي (SQLite) يخزّن quote_number بنمط QUO-0001 عبر
 * next_quote_number، وحالاته السبع من QUOTE_STATUSES بافتراضي «مسودة» — بينما
 * مخطط PostgreSQL المرجعي (مرجع الويب) بخمس حالات وافتراضي «جديد». وset_quotation_status
 * بلا مصفوفة انتقالات: أي حالة من المجموعة تصلح والنص الحرفي «حالة عرض السعر غير صحيحة.»
 * لغيرها — و«مقبول» بلا أي أثر جانبي (لا سند ولا عقد؛ التحويل دالة صريحة
 * convert_quotation_to_contract بلا مستدعٍ واجهة وبلا عمود contract_id في المخطط
 * المرجعي فخارج نطاق الويب). لا نموذج Word يُبنى الآن (بند 9 لاحقًا).
 */
model Quotation {
  id              Int             @id @default(autoincrement())
  customerId      Int             @map("customer_id")
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId       Int?            @map("project_id")
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotationNumber String          @unique @map("quotation_number")
  description     String          @default("")
  totalAmount     Decimal         @default(0) @db.Decimal(18, 3) @map("total_amount")
  status          String          @default("جديد")
  validUntil      String          @default("") @map("valid_until")
  notes           String          @default("")
  createdBy       Int?            @map("created_by")
  createdByUser   User?           @relation("quotationCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  items           QuotationItem[]

  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int       @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  unit        String    @default("")
  quantity    Decimal   @default(0) @db.Decimal(18, 3)
  unitPrice   Decimal   @default(0) @db.Decimal(18, 3) @map("unit_price")
  totalPrice  Decimal   @default(0) @db.Decimal(18, 3) @map("total_price")
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([quotationId])
  @@map("quotation_items")
}

model VoucherPaymentLink {
  id        Int      @id @default(autoincrement())
  voucherId Int      @map("voucher_id")
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  kind      String // receipt | payment
  lineId    Int      @map("line_id") // payment_plan.id أو sub_payment_plan.id
  amount    Decimal
  createdAt DateTime @default(now())

  @@unique([voucherId, lineId])
  @@index([lineId])
  @@map("voucher_payment_links")
}

model Addendum {
  id             Int            @id @default(autoincrement())
  addendumNumber String         @map("addendum_number")
  contractId     Int            @map("contract_id")
  contract       Contract       @relation(fields: [contractId], references: [id])
  addendumType   String         @default("أمر تغييري") @map("addendum_type") // عقد إضافي|أمر تغييري
  adate          String         @default("")
  reason         String         @default("")
  description    String         @default("")
  amountAdd      Decimal        @default(0) @map("amount_add")
  amountDeduct   Decimal        @default(0) @map("amount_deduct")
  startDate      String         @default("") @map("start_date")
  endDate        String         @default("") @map("end_date")
  status         String         @default("مسودة") // مسودة|تحت المراجعة|معتمد|ملغى
  approvedDate   String         @default("") @map("approved_date")
  side           String         @default("client") // client|sub
  subContractId  Int?           @map("sub_contract_id")
  subContract    SubContract?   @relation(fields: [subContractId], references: [id])
  itemsCount     Int            @default(0) @map("items_count")
  appliedAt      String         @default("") @map("applied_at")
  cancelReason   String         @default("") @map("cancel_reason")
  cancelledAt    String         @default("") @map("cancelled_at")
  items          AddendumItem[]

  @@index([contractId, status])
  @@map("addendums")
}

model AddendumItem {
  id               Int          @id @default(autoincrement())
  addendumId       Int          @map("addendum_id")
  addendum         Addendum     @relation(fields: [addendumId], references: [id], onDelete: Cascade)
  side             String       @default("client")
  action           String       @default("add") // add|delete|unlink
  parentPartId     Int          @default(0) @map("parent_part_id")
  createdItemId    Int          @default(0) @map("created_item_id")
  restoreDeletedBy Int          @default(0) @map("restore_deleted_by")
  applied          Boolean      @default(false)
  boqItemId        Int?         @map("boq_item_id")
  boqItem          BoqItem?     @relation(fields: [boqItemId], references: [id])
  subContractId    Int?         @map("sub_contract_id")
  subContract      SubContract? @relation(fields: [subContractId], references: [id], onDelete: SetNull)
  description      String       @default("")
  qty              Decimal      @default(0)
  unit             String       @default("")
  unitPrice        Decimal      @default(0) @map("unit_price")
  amount           Decimal      @default(0)
  refKind          String       @default("") @map("ref_kind") // boq|plan|stage
  refId            Int          @default(0) @map("ref_id")

  @@index([addendumId])
  @@map("addendum_items")
}

model Claim {
  id             Int                 @id @default(autoincrement())
  claimNumber    String              @unique @map("claim_number")
  direction      String // out|in
  contractId     Int                 @map("contract_id")
  contract       Contract            @relation(fields: [contractId], references: [id])
  subContractId  Int?                @map("sub_contract_id")
  subContract    SubContract?        @relation(fields: [subContractId], references: [id])
  custLineId     Int?                @map("cust_line_id")
  custLine       PaymentPlanItem?    @relation(fields: [custLineId], references: [id])
  subLineId      Int?                @map("sub_line_id")
  subLine        SubPaymentPlanItem? @relation(fields: [subLineId], references: [id], onDelete: SetNull)
  title          String
  amount         Decimal
  dueDate        String              @default("") @map("due_date")
  voucherRef     String              @default("") @map("voucher_ref") // سند القبض المرتبط (سقف المطالبة out)
  status         String              @default("registered")
  postponedUntil String              @default("") @map("postponed_until")
  notes          String              @default("")
  createdAt      DateTime            @default(now())

  @@index([contractId])
  @@index([direction, status])
  @@map("claims")
}

// ==================== الباطن ====================

model Subcontractor {
  id               Int           @id @default(autoincrement())
  subCode          String        @unique @map("sub_code")
  name             String
  phone            String        @default("")
  email            String        @default("")
  activity         String        @default("")
  notes            String        @default("")
  showAllContracts Boolean       @default(false) @map("show_all_contracts")
  subContracts     SubContract[]
  createdAt        DateTime      @default(now())

  @@map("subcontractors")
}

model SubContract {
  id                Int                  @id @default(autoincrement())
  subcontractorId   Int                  @map("subcontractor_id")
  subcontractor     Subcontractor        @relation(fields: [subcontractorId], references: [id])
  contractId        Int                  @map("contract_id")
  contract          Contract             @relation(fields: [contractId], references: [id])
  amount            Decimal              @default(0)
  startDate         String               @default("") @map("start_date")
  endDate           String               @default("") @map("end_date")
  status            String               @default("نشط")
  description       String               @default("")
  cancelReason      String               @default("") @map("cancel_reason")
  cancelledAt       String               @default("") @map("cancelled_at")
  cancelCloseAmount Decimal              @default(0) @map("cancel_close_amount")
  items             SubContractItem[]
  planLines         SubPaymentPlanItem[]
  vouchers          Voucher[]
  claims            Claim[]
  addendums         Addendum[]
  addendumItems     AddendumItem[]
  createdAt         DateTime             @default(now())

  @@index([contractId])
  @@map("sub_contracts")
}

model SubContractItem {
  id            Int         @id @default(autoincrement())
  subContractId Int         @map("sub_contract_id")
  subContract   SubContract @relation(fields: [subContractId], references: [id], onDelete: Cascade)
  boqItemId     Int?        @map("boq_item_id")
  boqItem       BoqItem?    @relation(fields: [boqItemId], references: [id])
  qty           Decimal     @default(0)
  unitPrice     Decimal     @default(0) @map("unit_price")
  amount        Decimal     @default(0)
  sourceKind    String      @default("") @map("source_kind") // boq|plan للبنود المنزّلة
  sourceId      Int         @default(0) @map("source_id")

  @@index([subContractId])
  @@map("sub_contract_items")
}

model SubPaymentPlanItem {
  id            Int                @id @default(autoincrement())
  subContractId Int                @map("sub_contract_id")
  subContract   SubContract        @relation(fields: [subContractId], references: [id], onDelete: Cascade)
  title         String
  dueDate       String             @map("due_date")
  amount        Decimal
  sortOrder     Int                @default(0) @map("sort_order")
  stageId       Int?               @map("stage_id") // مرحلة من عقد العميل الأب
  stage         ContractStage?     @relation(fields: [stageId], references: [id])
  notes         String             @default("")
  triggeredAt   String             @default("") @map("triggered_at")
  sources       SubPaymentSource[]
  claims        Claim[]
  createdAt     DateTime           @default(now())

  @@index([subContractId])
  @@map("sub_payment_plan")
}

model SubPaymentSource {
  id         Int                @id @default(autoincrement())
  subLineId  Int                @map("sub_line_id")
  subLine    SubPaymentPlanItem @relation(fields: [subLineId], references: [id], onDelete: Cascade)
  custLineId Int                @map("cust_line_id")
  custLine   PaymentPlanItem    @relation(fields: [custLineId], references: [id], onDelete: Cascade)

  @@unique([subLineId, custLineId])
  @@map("sub_payment_sources")
}

// ==================== أنواع العقود وقوالبها ====================

model ContractType {
  id               Int                   @id @default(autoincrement())
  name             String                @unique
  defaultAmount    Decimal               @default(0) @map("default_amount")
  notes            String                @default("")
  active           Boolean               @default(true)
  manualTrack      Boolean               @default(false) @map("manual_track")
  unitLabel        String                @default("") @map("unit_label")
  unitPrice        Decimal               @default(0) @map("unit_price")
  pricingMode      String                @default("lump") @map("pricing_mode") // lump|unit|items|bundle
  isSupervision    Boolean               @default(false) @map("is_supervision")
  paymentTemplates TypePaymentTemplate[]
  bundleParents    TypeBundleComponent[] @relation("bundleParent")
  bundleComponents TypeBundleComponent[] @relation("bundleComponent")

  @@map("contract_types")
}

model TypePaymentTemplate {
  id             Int                @id @default(autoincrement())
  contractTypeId Int                @map("contract_type_id")
  contractType   ContractType       @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)
  payNo          Int                @map("pay_no")
  title          String             @default("")
  pct            Decimal            @default(0)
  amountFixed    Decimal            @default(0) @map("amount_fixed")
  triggerStageId Int?               @map("trigger_stage_id")
  triggerStage   WorkflowStage?     @relation("paymentTrigger", fields: [triggerStageId], references: [id], onDelete: SetNull)
  daysOffset     Int                @default(0) @map("days_offset")
  linkKeyword    String             @default("") @map("link_keyword")
  stageLinks     TypePaymentStage[]

  @@unique([contractTypeId, payNo])
  @@map("type_payment_tpl")
}

model TypePaymentStage {
  id        Int                 @id @default(autoincrement())
  paymentId Int                 @map("payment_id")
  payment   TypePaymentTemplate @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  stageId   Int                 @map("stage_id")
  stage     WorkflowStage       @relation(fields: [stageId], references: [id])

  @@unique([stageId])
  @@map("type_payment_stages")
}

model TypeBundleComponent {
  id              Int          @id @default(autoincrement())
  parentTypeId    Int          @map("parent_type_id")
  parentType      ContractType @relation("bundleParent", fields: [parentTypeId], references: [id], onDelete: Cascade)
  componentTypeId Int          @map("component_type_id")
  componentType   ContractType @relation("bundleComponent", fields: [componentTypeId], references: [id])
  qty             Decimal      @default(1)

  @@index([parentTypeId])
  @@map("type_bundle_components")
}

model WorkflowStage {
  id                      Int                   @id @default(autoincrement())
  transactionType         String                @map("transaction_type") // contract|payment|subcontract|customer
  stageName               String                @map("stage_name")
  stageOrder              Int                   @default(0) @map("stage_order")
  color                   String                @default("#3B82F6")
  parentId                Int?                  @map("parent_id")
  parent                  WorkflowStage?        @relation("tree", fields: [parentId], references: [id])
  children                WorkflowStage[]       @relation("tree")
  expectedDays            Int                   @default(0) @map("expected_days")
  isPreContract           Boolean               @default(false) @map("is_pre_contract")
  contractType            String                @default("") @map("contract_type") // '' = القالب العام
  paymentPct              Decimal               @default(0) @map("payment_pct")
  payKind                 String                @default("") @map("pay_kind")
  isSupervision           Boolean               @default(false) @map("is_supervision")
  supMonthly              Decimal               @default(0) @map("sup_monthly")
  componentKey            String                @default("") @map("component_key")
  templateLinks           TypePaymentStage[]
  scopes                  ContractScope[]
  paymentTriggerTemplates TypePaymentTemplate[] @relation("paymentTrigger")

  @@unique([transactionType, contractType, stageName])
  @@map("workflow_stages")
}

model ContractScope {
  contractId      Int           @map("contract_id")
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  templateStageId Int           @map("template_stage_id")
  templateStage   WorkflowStage @relation(fields: [templateStageId], references: [id])

  @@id([contractId, templateStageId])
  @@map("contract_scope")
}

