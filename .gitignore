# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# internal agent artifacts & redundant source splits
tool-results/
upload/

# قالب المتغيرات (بلا أسرار) يُرفع للمستودع
!.env.example

# قواعد البيانات المحلية لا تُتتبع (يطلبها تقرير الأمان)
db/

# ملفات تشغيلية متغيرة (PID وغيرها) لا معنى لتتبعها
.zscripts/dev.pid
*.pid

# G13 — بقايا بايثون وملفات استرجاع (المكتبي المرجعي يبقى مصدره فقط بلا كاش)
**/__pycache__/
*.pyc
restore_report.json
restore_source.py

# نسخ البيانات الاحتياطية المحلية
backups/

# postgres محلي للتحقق الحي (بيئة التطوير فقط)
.pgdata/
.pgsock/

# بند NOVA 3 — بيانات Postgres المضمّن وسجل التحقق الحي لا تُتتبع
.embedded-pgdata/
dev-verify.log

# مرجع NOVA الأساسي (كود المالك للقراءة فقط) — يحتوي .env خاصًا بـFirebase
# و.git داخليًا ولا يُرفع للمستودع إطلاقًا (الـREADME الموثّق يبقى متتبعًا)
nova-reference/nova-erp/
