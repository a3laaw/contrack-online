# ============================================
# ConTrack Online — متغيرات البيئة (نموذج)
# انسخ القيم إلى .env (محليًا) أو إلى Vercel → Settings → Environment Variables
# ملاحظة: لا ترفع ملفات .env* إلى git (مستثناة في .gitignore — عدا هذا القالب)
# ============================================

# ---- قاعدة البيانات ----
# محليًا (الوضع المرجعي القديم — SQLite):
# DATABASE_URL="file:./db/custom.db"

# Supabase Postgres — المشروع gcvuwptcleawspsvpdwp (المنطقة ap-northeast-1)
# مضيف الاتصال المباشر db.<ref>.supabase.co يحل إلى IPv6 فقط، لذا كل الروابط تمر عبر Supavisor Pooler:

# 1) التشغيل (Vercel/serverless) — Transaction Pooler 6543:
DATABASE_URL="postgresql://postgres.gcvuwptcleawspsvpdwp:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2) أوامر Prisma (db push / migrate) — Session Pooler 5432:
DIRECT_URL="postgresql://postgres.gcvuwptcleawspsvpdwp:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# 3) للتشغيل المحلي من بيئات بلا تفريق، يمكن استخدام Session Pooler 5432 لكلتيهما.

# ---- الأمان ----
# سرّ توقيع التوكنات (src/lib/auth.ts) — ولّده عشوائيًا: openssl rand -hex 32
# مُضبوط على Vercel لكل البيئات؛ محليًا يكفي الافتراضي في بيئة التطوير.
# AUTH_SECRET="<64 hex>"

# ---- أين تجد القيم في لوحة Supabase ----
#  Project Settings → Database → Connection string → URI (اختر Pooler أو Direct)
#  Project Settings → API → Project URL + publishable/secret keys
#  كلمة مرور قاعدة البيانات: Project Settings → Database → Reset database password

# ---- الترحيل من SQLite ----
# بعد db push على Supabase شغّل:
#   DATABASE_URL="<رابط 5432 أعلاه>" bun scripts/migrate-to-supabase.ts
